# Copy this file to .env on the VPS, then replace every placeholder locally on the VPS.
# Never send or commit the real .env file.
DB_NAME=DonateWebDB
DB_USER=donateweb_app
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
PAYOS_CLIENT_ID=CHANGE_ME
PAYOS_API_KEY=CHANGE_ME
PAYOS_CHECKSUM_KEY=CHANGE_ME
# Create an API-key authenticated SePay webhook before enabling direct bank donations.
SEPAY_API_KEY=
# OpenAI API key for the support assistant. Enter it only in the private .env file on the VPS.
SUPPORT_AI_API_KEY=
SUPPORT_AI_MODEL=gpt-5.4-mini
SUPPORT_AI_MONTHLY_TOKEN_LIMIT=100000
SUPPORT_AI_MAX_OUTPUT_TOKENS=500
# Tài khoản trung tâm đã liên kết SePay; mọi QR streamer sẽ nhận tiền tại đây.
SEPAY_BANK_NAME=MB Bank
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# Wallet deposits use these values; blank account fields fall back to the SePay account above.
BANK_CONFIG_BANK_ID=MB
BANK_CONFIG_ACCOUNT_NO=
BANK_CONFIG_ACCOUNT_NAME=
BANK_CONFIG_BANK_NAME=MB Bank
# Optional JWT signing secret (at least 32 UTF-8 bytes) for API token generation.
JWT_SECRET_KEY=
# Keep empty until you have a public HTTPS domain.
PUBLIC_BASE_URL=
PLATFORM_CONTRACT_OPERATOR_CAPACITY=Cá nhân
PLATFORM_CONTRACT_OPERATOR_LEGAL_NAME=Nguyễn Anh Hiếu
PLATFORM_CONTRACT_OPERATOR_ADDRESS=Thông tin minh họa (bài tập lớn)
PLATFORM_CONTRACT_OPERATOR_REGISTRATION_NUMBER=Không áp dụng trong bản demo cá nhân
PLATFORM_CONTRACT_CONTACT_EMAIL=cupitcookies@gmail.com
# Add the ElevenLabs key and the Voice ID from your ElevenLabs account on the VPS only.
# Never paste the API key into OBS, the browser, or chat.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Google OAuth Client ID and Secret from Google Cloud Console.
# Authorized redirect URI: https://plantsdonate.duckdns.org/signin-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta Developers -> Facebook Login for Web; callback URI:
# https://plantsdonate.duckdns.org/signin-facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# GHN integration stays on staging and only previews fees; it does not create shipping orders.
GHN_TOKEN=
GHN_SHOP_ID=230944
