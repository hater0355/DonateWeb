# Copy this file to .env on the VPS, then replace every placeholder locally on the VPS.
# Never send or commit the real .env file.
DB_NAME=DonateWebDB
DB_USER=donateweb_app
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
PAYOS_CLIENT_ID=CHANGE_ME
PAYOS_API_KEY=CHANGE_ME
PAYOS_CHECKSUM_KEY=CHANGE_ME
# Create an API-key authenticated SePay webhook before enabling direct bank donations.
SEPAY_API_KEY=
# Tài khoản trung tâm đã liên kết SePay; mọi QR streamer sẽ nhận tiền tại đây.
SEPAY_BANK_NAME=MB Bank
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# Keep empty until you have a public HTTPS domain.
PUBLIC_BASE_URL=
# Add the ElevenLabs key and the Voice ID from your ElevenLabs account on the VPS only.
# Never paste the API key into OBS, the browser, or chat.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Google OAuth Client ID and Secret from Google Cloud Console.
# Authorized redirect URI: https://plantsdonate.duckdns.org/signin-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Meta Developers -> Facebook Login for Web; callback URI:
# https://plantsdonate.duckdns.org/signin-facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
