<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
<script>
    // =========================================================================
    // [MỚI THÊM]: Script xử lý chọn phương thức thanh toán và tự động sinh mã QR
    // chứa thông tin Số tiền + Nội dung chuyển khoản ngay trên giao diện Viewer
    // =========================================================================
    const currentWalletBalance = @Model.CurrentWalletBalance.ToString(System.Globalization.CultureInfo.InvariantCulture);
    const streamerSlug = '@Model.Slug';
    let qrUpdateTimer = null;

    // Biến quản lý phiên thanh toán Donate VietQR Real-time
    let donateHubConnection = null;
    let donatePollingInterval = null;
    let donateCountdownInterval = null;
    let currentDonationId = null;
    let currentDonationCode = null;
    let donateRemainingSeconds = 600;

    function setAmount(val) {
        const amountInput = document.getElementById('donateAmountInput');
        if (amountInput) {
            amountInput.value = val;
        }
        document.querySelectorAll('.quick-amount-btn').forEach(btn => btn.classList.remove('active'));
        if (event && event.target) {
            event.target.classList.add('active');
        }
        // [MỚI THÊM]: Cập nhật lại mã QR và kiểm tra số dư khi chọn mệnh giá nhanh
        checkWalletBalance();
        scheduleQrUpdate();
    }

    // [MỚI THÊM]: Kiểm tra số dư ví có đủ so với số tiền nhập hay không
    function checkWalletBalance() {
        const amountInput = document.getElementById('donateAmountInput');
        const warningEl = document.getElementById('walletInsufficientWarning');
        const walletRadio = document.getElementById('paymentWalletRadio');
        if (!amountInput || !warningEl || !walletRadio) return;

        const amount = parseFloat(amountInput.value) || 0;
        if (walletRadio.checked && amount > currentWalletBalance) {
            warningEl.classList.remove('d-none');
        } else {
            warningEl.classList.add('d-none');
        }
    }

    // [MỚI THÊM]: Chuyển đổi hiển thị giữa "Số dư tài khoản" và "Chuyển khoản ngân hàng (Mã QR)"
    function handlePaymentMethodChange() {
        const walletRadio = document.getElementById('paymentWalletRadio');
        const bankRadio = document.getElementById('paymentBankRadio');
        const walletBox = document.getElementById('walletPaymentInfoBox');
        const bankQrBox = document.getElementById('bankQrPaymentBox');
        const submitBtn = document.getElementById('submitDonateBtn');

        if (!walletRadio || !bankRadio) return;

        if (bankRadio.checked) {
            if (walletBox) walletBox.classList.add('d-none');
            if (bankQrBox) bankQrBox.classList.remove('d-none');
            if (submitBtn) {
                submitBtn.innerHTML = '<i class="fa-solid fa-check-circle me-2"></i> XÁC NHẬN ĐÃ CHUYỂN KHOẢN (@Model.DisplayName)';
            }
            scheduleQrUpdate();
        } else {
            if (walletBox) walletBox.classList.remove('d-none');
            if (bankQrBox) bankQrBox.classList.add('d-none');
            if (submitBtn) {
                submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane me-2"></i> ỦNG HỘ NGAY (@Model.DisplayName)';
            }
            checkWalletBalance();
        }
    }

    // [MỚI THÊM]: Gọi AJAX lên Server (/Streamer/GenerateQrAjax) để tạo lại mã QR
    // chứa thông tin Số tiền và Nội dung chuyển khoản mới nhất
    function scheduleQrUpdate() {
        if (qrUpdateTimer) clearTimeout(qrUpdateTimer);
        qrUpdateTimer = setTimeout(fetchUpdatedQrCode, 300);
    }

    async function fetchUpdatedQrCode() {
        const amountInput = document.getElementById('donateAmountInput');
        const donorInput = document.getElementById('DonorName');
        const messageInput = document.getElementById('Message');
        if (!amountInput) return;

        const amount = parseFloat(amountInput.value) || 0;
        const donorName = donorInput ? donorInput.value : '';
        const message = messageInput ? messageInput.value : '';

        try {
            const url = `/Streamer/GenerateQrAjax?slug=${encodeURIComponent(streamerSlug)}&amount=${encodeURIComponent(amount)}&donorName=${encodeURIComponent(donorName)}&message=${encodeURIComponent(message)}`;
            const response = await fetch(url);
            if (!response.ok) return;

            const data = await response.json();
            if (data && (data.success || data.qrBase64)) {
                // Cập nhật ảnh QR trên cả khung trong Form và cột bên phải
                const inlineImg = document.getElementById('inlineGeneratedQrImg');
                const sideImg = document.getElementById('sideGeneratedQrImg');
                const sidePlaceholder = document.getElementById('sideQrPlaceholder');

                if (inlineImg && data.qrBase64) {
                    inlineImg.src = data.qrBase64;
                    inlineImg.classList.remove('d-none');
                }
                if (sideImg && data.qrBase64) {
                    sideImg.src = data.qrBase64;
                    sideImg.classList.remove('d-none');
                    if (sidePlaceholder) sidePlaceholder.classList.add('d-none');
                }

                // Cập nhật text số tiền và nội dung chuyển khoản
                const inlineAmount = document.getElementById('inlineQrAmountText');
                const sideAmount = document.getElementById('sideQrAmountText');
                if (inlineAmount) inlineAmount.textContent = data.formattedAmount;
                if (sideAmount) sideAmount.textContent = data.formattedAmount;

                const inlineContent = document.getElementById('inlineQrContentText');
                const sideContent = document.getElementById('sideQrContentText');
                if (inlineContent) inlineContent.textContent = data.transferContent;
                if (sideContent) sideContent.textContent = data.transferContent;
            }
        } catch (err) {
            console.error('Lỗi khi cập nhật mã QR:', err);
        }
    }

    // Sao chép nội dung chuyển khoản nhanh
    function copyTransferContent(elementId) {
        const el = document.getElementById(elementId);
        if (!el) return;
        const text = (el.innerText || el.textContent || '').trim();
        if (!text) return;

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(function() {
                showCopyToast('Đã sao chép nội dung: ' + text);
            }).catch(function() {
                fallbackCopyText(text);
            });
        } else {
            fallbackCopyText(text);
        }
    }

    function fallbackCopyText(text) {
        const tempInput = document.createElement('textarea');
        tempInput.value = text;
        document.body.appendChild(tempInput);
        tempInput.select();
        document.execCommand('copy');
        document.body.removeChild(tempInput);
        showCopyToast('Đã sao chép nội dung: ' + text);
    }

    function showCopyToast(msg) {
        alert(msg);
    }

    // [MỚI THÊM]: Lắng nghe sự kiện thay đổi Số tiền, Tên người gửi, Lời nhắn để cập nhật QR tức thì
    document.addEventListener('DOMContentLoaded', function () {
        const amountInput = document.getElementById('donateAmountInput');
        const donorInput = document.getElementById('DonorName');
        const messageInput = document.getElementById('Message');

        if (amountInput) {
            amountInput.addEventListener('input', function () {
                checkWalletBalance();
                scheduleQrUpdate();
            });
        }
        if (donorInput) {
            donorInput.addEventListener('input', scheduleQrUpdate);
        }
        if (messageInput) {
            messageInput.addEventListener('input', scheduleQrUpdate);
        }

        handlePaymentMethodChange();

        // Gắn sự kiện submit cho form donate
        const donateForm = document.getElementById('donateForm');
        if (donateForm) {
            donateForm.addEventListener('submit', function (e) {
                const bankRadio = document.getElementById('paymentBankRadio');
                // Nếu người dùng chọn phương thức Chuyển khoản ngân hàng (VietQR)
                if (bankRadio && bankRadio.checked) {
                    e.preventDefault();
                    handleBankDonateSubmit();
                }
            });
        }
    });

    // =========================================================================
    // XỬ LÝ QUÉT MÃ VIETQR REAL-TIME QUA PAYOS & SIGNALR
    // =========================================================================

    // Gửi yêu cầu tạo đơn donate Pending và mở Modal VietQR
    async function handleBankDonateSubmit() {
        const submitBtn = document.getElementById('submitDonateBtn');
        const originalBtnHtml = submitBtn ? submitBtn.innerHTML : '';

        const amountInput = document.getElementById('donateAmountInput');
        const donorInput = document.getElementById('DonorName');
        const messageInput = document.getElementById('Message');
        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');

        const amount = parseFloat(amountInput ? amountInput.value : 0) || 0;
        const donorName = donorInput ? donorInput.value.trim() : '';
        const message = messageInput ? messageInput.value.trim() : '';

        if (!donorName) {
            alert('Vui lòng nhập Tên của bạn / Biệt danh để streamer biết ai ủng hộ.');
            if (donorInput) donorInput.focus();
            return;
        }

        if (amount < @Model.MinDonateAmount) {
            alert('Số tiền ủng hộ tối thiểu là @Model.MinDonateAmount.ToString("N0") VNĐ.');
            if (amountInput) amountInput.focus();
            return;
        }

        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> Đang tạo mã VietQR...';
        }

        try {
            const formData = new URLSearchParams();
            formData.append('slug', streamerSlug);
            formData.append('donorName', donorName);
            formData.append('amount', amount);
            formData.append('message', message);
            if (tokenInput) formData.append('__RequestVerificationToken', tokenInput.value);

            const response = await fetch('/Streamer/CreateBankDonation', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: formData.toString()
            });

            const result = await response.json();

            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalBtnHtml;
            }

            if (!response.ok || !result.success) {
                alert(result.message || 'Không thể khởi tạo mã VietQR. Vui lòng thử lại sau.');
                return;
            }

            // Mở Modal hiển thị mã VietQR Real-time
            openVietQrModal(result);

        } catch (err) {
            console.error('Lỗi khi gọi API CreateBankDonation:', err);
            alert('Đã xảy ra lỗi kết nối với máy chủ. Vui lòng thử lại.');
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalBtnHtml;
            }
        }
    }

    // Mở Modal VietQR và kích hoạt cơ chế lắng nghe Real-time kép (SignalR + Polling AJAX Fallback)
    function openVietQrModal(data) {
        currentDonationId = data.donationId;
        currentDonationCode = data.transactionCode;
        donateRemainingSeconds = data.expireSeconds || 600;

        // Điền dữ liệu vào Modal
        document.getElementById('modalVietQrImage').src = data.qrUrl;
        document.getElementById('modalAmountDisplay').textContent = data.formattedAmount;
        document.getElementById('modalBankNameDisplay').textContent = data.bankId;
        document.getElementById('modalAccountNoDisplay').textContent = data.accountNo;
        document.getElementById('modalAccountNameDisplay').textContent = data.accountName;
        document.getElementById('modalMemoDisplay').textContent = data.memo;
        document.getElementById('modalStreamerNameDisplay').textContent = data.streamerName || '@Model.DisplayName';

        // Đảm bảo trạng thái ban đầu là đang chờ quét mã
        document.getElementById('modalWaitingPaymentState').classList.remove('d-none');
        document.getElementById('modalSuccessPaymentState').classList.add('d-none');

        // Khởi chạy đếm ngược 10 phút
        startDonateCountdown();

        // 1. Kích hoạt kết nối SignalR Real-time Hub (0 delay)
        initSignalRDonation(data.transactionCode, data.donationId);

        // 2. Kích hoạt Polling AJAX dự phòng mỗi 3 giây
        startDonatePolling(data.donationId, data.transactionCode);

        // Hiển thị Bootstrap Modal
        const modalEl = document.getElementById('vietQrPaymentModal');
        const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
        modalInstance.show();
    }

    // Khởi tạo kết nối SignalR lắng nghe sự kiện DonationSuccess khi Webhook PayOS xử lý thành công
    function initSignalRDonation(txCode, donationId) {
        if (typeof signalR === 'undefined') {
            console.warn('[SignalR] Thư viện SignalR chưa nạp, sử dụng Polling AJAX Fallback.');
            return;
        }

        try {
            if (donateHubConnection) {
                donateHubConnection.stop();
                donateHubConnection = null;
            }

            donateHubConnection = new signalR.HubConnectionBuilder()
                .withUrl('/paymentHub')
                .withAutomaticReconnect([0, 2000, 5000, 10000])
                .build();

            // Lắng nghe sự kiện DonationSuccess từ PaymentWebhookController
            donateHubConnection.on('DonationSuccess', function (res) {
                console.log('[SignalR Real-time] Nhận sự kiện DonationSuccess từ PayOS Webhook:', res);
                if (res && (res.transactionCode === txCode || res.donationId == donationId)) {
                    showDonationSuccessUI(res);
                }
            });

            donateHubConnection.start().then(function () {
                console.log('[SignalR Real-time] Đã kết nối PaymentHub cho giao dịch donate:', txCode);
                // Tham gia nhóm giao dịch
                donateHubConnection.invoke('JoinTransactionGroup', txCode);
                if (donationId) {
                    donateHubConnection.invoke('JoinTransactionGroup', donationId.toString());
                }
            }).catch(function (err) {
                console.warn('[SignalR] Lỗi kết nối Hub, tiếp tục với Polling AJAX:', err);
            });

        } catch (err) {
            console.error('[SignalR] Ngoại lệ khi tạo SignalR Connection:', err);
        }
    }

    // Polling AJAX dự phòng kiểm tra trạng thái mỗi 3 giây
    function startDonatePolling(donationId, txCode) {
        clearInterval(donatePollingInterval);

        donatePollingInterval = setInterval(async () => {
            if (!currentDonationId) return;

            try {
                const res = await fetch(`/Streamer/CheckDonationStatus?donationId=${encodeURIComponent(donationId)}&transactionCode=${encodeURIComponent(txCode)}`);
                if (!res.ok) return;

                const data = await res.json();
                if (data && data.isPaid) {
                    console.log('[Polling AJAX] Đã phát hiện giao dịch donate thành công từ API:', data);
                    showDonationSuccessUI(data);
                }
            } catch (e) {
                console.error('Lỗi khi polling trạng thái donate:', e);
            }
        }, 3000);
    }

    // Hiển thị giao diện "Thanh toán & Gửi Donate thành công" tự động mà không cần F5
    function showDonationSuccessUI(data) {
        // Dừng toàn bộ timer, polling và ngắt kết nối SignalR
        stopDonateListening();

        // Ẩn giao diện quét mã, hiển thị giao diện chúc mừng
        const waitingState = document.getElementById('modalWaitingPaymentState');
        const successState = document.getElementById('modalSuccessPaymentState');
        if (waitingState) waitingState.classList.add('d-none');
        if (successState) successState.classList.remove('d-none');

        // Cập nhật thông tin vào màn hình chúc mừng
        const amountEl = document.getElementById('successModalAmount');
        const streamerEl = document.getElementById('successModalStreamer');
        const txCodeEl = document.getElementById('successModalTxCode');

        if (amountEl && data.amount) amountEl.textContent = '+' + Number(data.amount).toLocaleString('vi-VN') + ' VNĐ';
        if (streamerEl && data.streamerName) streamerEl.textContent = data.streamerName;
        if (txCodeEl) txCodeEl.textContent = data.transactionCode || currentDonationCode || 'Thành công';

        // Tự động phát âm thanh thông báo vui tươi nếu trình duyệt cho phép
        try {
            const audio = new Audio('https://assets.mixkit.co/active_storage/sfx/2018/2018-preview.mp3');
            audio.volume = 0.6;
            audio.play().catch(() => {});
        } catch (e) {}
    }

    // Đồng hồ đếm ngược 10 phút trong modal
    function startDonateCountdown() {
        clearInterval(donateCountdownInterval);
        const timerEl = document.getElementById('modalCountdownDisplay');

        function update() {
            const m = Math.floor(donateRemainingSeconds / 60);
            const s = donateRemainingSeconds % 60;
            if (timerEl) timerEl.textContent = `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;

            if (donateRemainingSeconds <= 0) {
                clearInterval(donateCountdownInterval);
                clearInterval(donatePollingInterval);
                if (timerEl) timerEl.textContent = 'HẾT HẠN';
                alert('Mã VietQR này đã hết hạn hiệu lực 10 phút. Vui lòng bấm tạo mã mới để tiếp tục.');
                stopDonateListening();
                const modalEl = document.getElementById('vietQrPaymentModal');
                const modalInstance = bootstrap.Modal.getInstance(modalEl);
                if (modalInstance) modalInstance.hide();
            } else {
                donateRemainingSeconds--;
            }
        }

        update();
        donateCountdownInterval = setInterval(update, 1000);
    }

    // Dừng toàn bộ tiến trình lắng nghe thanh toán
    function stopDonateListening() {
        if (donatePollingInterval) clearInterval(donatePollingInterval);
        if (donateCountdownInterval) clearInterval(donateCountdownInterval);
        donatePollingInterval = null;
        donateCountdownInterval = null;
        currentDonationId = null;
        currentDonationCode = null;

        if (donateHubConnection) {
            donateHubConnection.stop();
            donateHubConnection = null;
        }
    }

    // Hàm sao chép thông tin trong modal
    function copyModalField(fieldId, btnElement) {
        const el = document.getElementById(fieldId);
        if (!el) return;
        const text = (el.innerText || el.textContent || '').trim();
        if (!text) return;

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(() => {
                showModalCopiedFeedback(btnElement);
            }).catch(() => {
                fallbackCopyModal(text, btnElement);
            });
        } else {
            fallbackCopyModal(text, btnElement);
        }
    }

    function fallbackCopyModal(text, btnElement) {
        const temp = document.createElement('textarea');
        temp.value = text;
        document.body.appendChild(temp);
        temp.select();
        document.execCommand('copy');
        document.body.removeChild(temp);
        showModalCopiedFeedback(btnElement);
    }

    function showModalCopiedFeedback(btnElement) {
        if (!btnElement) return;
        const orig = btnElement.innerHTML;
        btnElement.innerHTML = '<i class="fa-solid fa-check me-1"></i> Đã chép!';
        setTimeout(() => {
            btnElement.innerHTML = orig;
        }, 2000);
    }
</script>

