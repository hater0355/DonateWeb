                        }
                    </form>
                </div>
            }
        </div>

        <!-- Cột phải: Khung Mã QR Donate Streamer (Đã xóa thông tin ngân hàng, chỉ giữ lại mã QR) -->
        <div class="col-12 col-lg-5">
            <div class="card card-custom p-4 bg-white border-0 shadow-sm h-100 d-flex flex-column">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h6 class="fw-bold text-dark-green mb-0 text-uppercase">
                        <i class="fa-solid fa-qrcode text-success me-2"></i> MÃ QR DONATE
                    </h6>
                    <span class="badge bg-light-green text-dark-green border small">
                        <i class="fa-solid fa-bolt text-success me-1"></i> Quét nhanh
                    </span>
                </div>

                <!-- Khung hiển thị Mã QR chính -->
                <div class="text-center p-3 bg-light rounded-3 border mb-3">
                    <div class="bg-white p-2 rounded-3 border shadow-sm d-inline-block position-relative">
                        @{
                            var qrSource = !string.IsNullOrEmpty(Model.PaymentQrUrl) 
                                ? Model.PaymentQrUrl 
                                : (!string.IsNullOrEmpty(Model.GeneratedQrBase64) ? Model.GeneratedQrBase64 : null);
                        }
                        <img id="sideGeneratedQrImg"
                             src="@qrSource"
                             alt="Mã QR nhận donate @Model.DisplayName"
                             class="img-fluid rounded-2 @(string.IsNullOrEmpty(qrSource) ? "d-none" : "")"
                             style="max-height: 220px; min-width: 180px; object-fit: contain;" />
                        
                        <div id="sideQrPlaceholder" class="p-4 d-flex flex-column align-items-center justify-content-center @(!string.IsNullOrEmpty(qrSource) ? "d-none" : "")" style="min-width: 190px; min-height: 190px;">
                            <div class="p-3 rounded-circle bg-light-green mb-2">
                                <i class="fa-solid fa-qrcode text-success display-4"></i>
                            </div>
                            <span class="fw-bold text-dark-green small">Mã QR Streamer</span>
                            <span class="text-muted small mt-1" style="font-size: 0.75rem;">(Mã QR sẽ được cập nhật)</span>
                        </div>
                    </div>
                    <div class="small text-dark-green fw-semibold mt-2">
                        <i class="fa-solid fa-camera text-success me-1"></i> Quét mã QR bằng App Ngân hàng hoặc Ví điện tử
                    </div>
                    <div class="small text-muted" style="font-size: 0.75rem;">
                        Hỗ trợ tất cả ứng dụng ngân hàng (VietQR) và Ví điện tử
                    </div>
                </div>

                <!-- Khung hiển thị Số tiền & Nội dung chuyển khoản cần quét -->
                <div class="bg-light-green p-3 rounded-3 border flex-grow-1 d-flex flex-column justify-content-between">
                    <div>
                        <div class="mb-3">
                            <small class="text-muted d-block fw-semibold">Số tiền ủng hộ:</small>
                            <strong id="sideQrAmountText" class="text-danger fs-5">@Model.Amount.ToString("N0") VNĐ</strong>
                        </div>
                        <div class="mb-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <small class="text-muted fw-semibold">Nội dung chuyển khoản (bắt buộc):</small>
                                <button type="button" class="btn btn-sm btn-link text-success p-0 text-decoration-none fw-semibold" style="font-size: 0.78rem;" onclick="copyTransferContent('sideQrContentText')">
                                    <i class="fa-regular fa-copy me-1"></i>Sao chép
                                </button>
                            </div>
                            <code id="sideQrContentText" class="bg-white p-2 rounded text-success fw-bold d-block border">@Model.TransferContent</code>
                        </div>
                    </div>
                    <div class="mt-3 text-muted small" style="font-size: 0.75rem;">
                        <i class="fa-solid fa-circle-info text-success me-1"></i>
                        Vui lòng giữ đúng nội dung chuyển khoản để hệ thống tự động ghi nhận donate và phát thông báo trên livestream.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Danh sách Streamer đề xuất khác -->
    <div class="mt-5 pt-4 border-top">
        <h6 class="fw-bold text-dark-green mb-3 text-uppercase">
            <i class="fa-solid fa-compass text-success me-2"></i> Khám phá các Streamer khác
        </h6>
        <div class="row g-3">
            <div class="col-6 col-md-3">
                <a href="/tenstreamer" class="text-decoration-none">
                    <div class="p-3 bg-white rounded-3 border shadow-sm d-flex align-items-center gap-3 transition">
                        <img src="https://api.dicebear.com/7.x/adventurer/svg?seed=HoangNam" class="rounded-circle border" width="45" height="45" />
                        <div>
                            <div class="fw-bold text-dark-green small">Hoàng Nam Gaming</div>
                            <div class="text-muted small" style="font-size: 0.72rem;">@@tenstreamer</div>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a href="/domixi" class="text-decoration-none">
                    <div class="p-3 bg-white rounded-3 border shadow-sm d-flex align-items-center gap-3 transition">
                        <img src="https://api.dicebear.com/7.x/adventurer/svg?seed=DoMixi" class="rounded-circle border" width="45" height="45" />
                        <div>
                            <div class="fw-bold text-dark-green small">Độ Phùng (Mixi)</div>
                            <div class="text-muted small" style="font-size: 0.72rem;">@@domixi</div>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a href="/pewpew" class="text-decoration-none">
                    <div class="p-3 bg-white rounded-3 border shadow-sm d-flex align-items-center gap-3 transition">
                        <img src="https://api.dicebear.com/7.x/adventurer/svg?seed=PewPew" class="rounded-circle border" width="45" height="45" />
                        <div>
                            <div class="fw-bold text-dark-green small">PewPew Channel</div>
                            <div class="text-muted small" style="font-size: 0.72rem;">@@pewpew</div>
                        </div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-md-3">
                <a href="/streamer/register" class="text-decoration-none">
                    <div class="p-3 bg-light-green rounded-3 border border-success shadow-sm d-flex align-items-center justify-content-center text-center gap-2 h-100">
                        <i class="fa-solid fa-plus-circle text-success fs-5"></i>
                        <span class="fw-bold text-dark-green small">Tạo kênh Streamer</span>
                    </div>
                </a>
            </div>
        </div>
    </div>

</div>

<script>
    // =========================================================================
    // [MỚI THÊM]: Script xử lý chọn phương thức thanh toán và tự động sinh mã QR
    // chứa thông tin Số tiền + Nội dung chuyển khoản ngay trên giao diện Viewer
    // =========================================================================
    const currentWalletBalance = @Model.CurrentWalletBalance.ToString(System.Globalization.CultureInfo.InvariantCulture);
    const streamerSlug = '@Model.Slug';
    let qrUpdateTimer = null;

    function setAmount(val) {
        const amountInput = document.getElementById('donateAmountInput');
        if (amountInput) {
            amountInput.value = val;
        }
        document.querySelectorAll('.quick-amount-btn').forEach(btn => btn.classList.remove('active'));
        if (event && event.target) {
            event.target.classList.add('active');
        }
        // [MỚI THÊM]: Cập nhật lại mã QR và kiểm tra số dư khi chọn mệnh giá nhanh
        checkWalletBalance();
        scheduleQrUpdate();
    }

    // [MỚI THÊM]: Kiểm tra số dư ví có đủ so với số tiền nhập hay không
    function checkWalletBalance() {
        const amountInput = document.getElementById('donateAmountInput');
        const warningEl = document.getElementById('walletInsufficientWarning');
        const walletRadio = document.getElementById('paymentWalletRadio');
        if (!amountInput || !warningEl || !walletRadio) return;

        const amount = parseFloat(amountInput.value) || 0;
        if (walletRadio.checked && amount > currentWalletBalance) {
            warningEl.classList.remove('d-none');
        } else {
            warningEl.classList.add('d-none');
        }
    }

    // [MỚI THÊM]: Chuyển đổi hiển thị giữa "Số dư tài khoản" và "Chuyển khoản ngân hàng (Mã QR)"
    function handlePaymentMethodChange() {
        const walletRadio = document.getElementById('paymentWalletRadio');
        const bankRadio = document.getElementById('paymentBankRadio');
        const walletBox = document.getElementById('walletPaymentInfoBox');
        const bankQrBox = document.getElementById('bankQrPaymentBox');
        const submitBtn = document.getElementById('submitDonateBtn');

        if (!walletRadio || !bankRadio) return;

        if (bankRadio.checked) {
            if (walletBox) walletBox.classList.add('d-none');
            if (bankQrBox) bankQrBox.classList.remove('d-none');
            if (submitBtn) {
                submitBtn.innerHTML = '<i class="fa-solid fa-check-circle me-2"></i> XÁC NHẬN ĐÃ CHUYỂN KHOẢN (@Model.DisplayName)';
            }
            scheduleQrUpdate();
        } else {
            if (walletBox) walletBox.classList.remove('d-none');
            if (bankQrBox) bankQrBox.classList.add('d-none');
            if (submitBtn) {
                submitBtn.innerHTML = '<i class="fa-solid fa-paper-plane me-2"></i> ỦNG HỘ NGAY (@Model.DisplayName)';
            }
            checkWalletBalance();
        }
    }

    // [MỚI THÊM]: Gọi AJAX lên Server (/Streamer/GenerateQrAjax) để tạo lại mã QR
    // chứa thông tin Số tiền và Nội dung chuyển khoản mới nhất
    function scheduleQrUpdate() {
        if (qrUpdateTimer) clearTimeout(qrUpdateTimer);
        qrUpdateTimer = setTimeout(fetchUpdatedQrCode, 300);
    }

    async function fetchUpdatedQrCode() {
        const amountInput = document.getElementById('donateAmountInput');
        const donorInput = document.getElementById('DonorName');
        const messageInput = document.getElementById('Message');
        if (!amountInput) return;

        const amount = parseFloat(amountInput.value) || 0;
        const donorName = donorInput ? donorInput.value : '';
        const message = messageInput ? messageInput.value : '';

        try {
            const url = `/Streamer/GenerateQrAjax?slug=${encodeURIComponent(streamerSlug)}&amount=${encodeURIComponent(amount)}&donorName=${encodeURIComponent(donorName)}&message=${encodeURIComponent(message)}`;
            const response = await fetch(url);
            if (!response.ok) return;

            const data = await response.json();
            if (data && (data.success || data.qrBase64)) {
                // Cập nhật ảnh QR trên cả khung trong Form và cột bên phải
                const inlineImg = document.getElementById('inlineGeneratedQrImg');
                const sideImg = document.getElementById('sideGeneratedQrImg');
                const sidePlaceholder = document.getElementById('sideQrPlaceholder');

                if (inlineImg && data.qrBase64) {
                    inlineImg.src = data.qrBase64;
                    inlineImg.classList.remove('d-none');
                }
                if (sideImg && data.qrBase64) {
                    sideImg.src = data.qrBase64;
                    sideImg.classList.remove('d-none');
                    if (sidePlaceholder) sidePlaceholder.classList.add('d-none');
                }

                // Cập nhật text số tiền và nội dung chuyển khoản
                const inlineAmount = document.getElementById('inlineQrAmountText');
                const sideAmount = document.getElementById('sideQrAmountText');
                if (inlineAmount) inlineAmount.textContent = data.formattedAmount;
                if (sideAmount) sideAmount.textContent = data.formattedAmount;

                const inlineContent = document.getElementById('inlineQrContentText');
                const sideContent = document.getElementById('sideQrContentText');
                if (inlineContent) inlineContent.textContent = data.transferContent;
                if (sideContent) sideContent.textContent = data.transferContent;
            }
        } catch (err) {
            console.error('Lỗi khi cập nhật mã QR:', err);
        }
    }

    // Sao chép nội dung chuyển khoản nhanh
    function copyTransferContent(elementId) {
        const el = document.getElementById(elementId);
        if (!el) return;
        const text = (el.innerText || el.textContent || '').trim();
        if (!text) return;

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(function() {
                showCopyToast('Đã sao chép nội dung: ' + text);
            }).catch(function() {
                fallbackCopyText(text);
            });
        } else {
            fallbackCopyText(text);
        }
    }

    function fallbackCopyText(text) {
        const tempInput = document.createElement('textarea');
        tempInput.value = text;
        document.body.appendChild(tempInput);
        tempInput.select();
        document.execCommand('copy');
        document.body.removeChild(tempInput);
        showCopyToast('Đã sao chép nội dung: ' + text);
    }

    function showCopyToast(msg) {
        alert(msg);
    }

    // [MỚI THÊM]: Lắng nghe sự kiện thay đổi Số tiền, Tên người gửi, Lời nhắn để cập nhật QR tức thì
    document.addEventListener('DOMContentLoaded', function () {
        const amountInput = document.getElementById('donateAmountInput');
        const donorInput = document.getElementById('DonorName');
        const messageInput = document.getElementById('Message');

        if (amountInput) {
            amountInput.addEventListener('input', function () {
                checkWalletBalance();
                scheduleQrUpdate();
            });
        }
        if (donorInput) {
            donorInput.addEventListener('input', scheduleQrUpdate);
        }
        if (messageInput) {
            messageInput.addEventListener('input', scheduleQrUpdate);
        }

        handlePaymentMethodChange();
    });
</script>

@if (isStreamerAccount)
{
    <script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const editorContainer = document.getElementById('streamerBioEditor');
            const hiddenInput = document.getElementById('streamerBioHiddenInput');
            const publicBioDisplay = document.getElementById('publicBioDisplay');

            if (editorContainer && hiddenInput) {
                const quill = new Quill('#streamerBioEditor', {
                    theme: 'snow',
                    placeholder: 'Nhập lời giới thiệu bản thân (Bio / About Me)...',
                    modules: {
                        toolbar: [
                            [{ 'header': [2, 3, false] }],
                            ['bold', 'italic', 'underline', 'strike'],
                            [{ 'color': [] }],
                            [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                            ['link', 'blockquote', 'clean']
                        ]
                    }
                });

                if (hiddenInput.value) {
                    quill.root.innerHTML = hiddenInput.value;
                }

                quill.on('text-change', function () {
                    const html = quill.root.innerHTML;
                    const isEmpty = quill.getText().trim().length === 0 && !html.includes('<img');
                    hiddenInput.value = isEmpty ? '' : html;

                    if (publicBioDisplay) {
                        publicBioDisplay.innerHTML = isEmpty
                            ? '<span class="text-muted fst-italic small">Chưa có lời giới thiệu bản thân.</span>'
                            : html;
                    }
                });

                const form = document.getElementById('streamerBioForm');
                if (form) {
                    form.addEventListener('submit', function () {
                        const html = quill.root.innerHTML;
                        const isEmpty = quill.getText().trim().length === 0 && !html.includes('<img');
                        hiddenInput.value = isEmpty ? '' : html;
                    });
                }
            }
        });
    </script>
}

