@model DonateWeb.Models.Entities.User
@{
    ViewData["Title"] = "Nạp tiền thành công";
    var tx = ViewBag.Transaction as DonateWeb.Models.Entities.WalletTransaction;
    var orderCode = ViewBag.OrderCode;
    var balance = ViewBag.WalletBalance ?? Model?.WalletBalance ?? 0;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card card-custom bg-white border-0 shadow-lg p-4 p-md-5 text-center rounded-4">
                <!-- Icon thành công -->
                <div class="mb-4">
                    <div class="mx-auto rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center shadow-sm" style="width: 90px; height: 90px; font-size: 3rem;">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>
                </div>

                <h3 class="fw-bold text-dark-green mb-2">NẠP TIỀN THÀNH CÔNG!</h3>
                <p class="text-muted mb-4">Giao dịch nạp tiền qua cổng thanh toán PayOS đã được xử lý hoàn tất và ghi nhận vào tài khoản của bạn.</p>

                <!-- Thẻ thông tin chi tiết -->
                <div class="bg-light rounded-3 p-3 p-md-4 text-start mb-4 border">
                    @if (orderCode != null)
                    {
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted small">Mã đơn hàng PayOS:</span>
                            <strong class="font-monospace text-dark-green">#@orderCode</strong>
                        </div>
                    }

                    @if (tx != null)
                    {
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted small">Mã giao dịch:</span>
                            <strong class="font-monospace text-dark">@tx.TransactionCode</strong>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted small">Số tiền đã nạp:</span>
                            <strong class="text-success fs-5">+@tx.Amount.ToString("N0") VNĐ</strong>
                        </div>
                    }

                    <div class="d-flex justify-content-between py-2">
                        <span class="text-muted small">Số dư ví hiện tại:</span>
                        <strong class="text-dark-green fs-5">@string.Format("{0:N0}", balance) VNĐ</strong>
                    </div>
                </div>

                <!-- Các nút điều hướng -->
                <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                    <a href="/Wallet/Deposit" class="btn btn-dark-green rounded-pill px-4 py-2 fw-semibold">
                        <i class="fa-solid fa-plus me-1"></i> Nạp thêm tiền
                    </a>
                    <a href="/Streamer/Donate" class="btn btn-outline-success rounded-pill px-4 py-2 fw-semibold">
                        <i class="fa-solid fa-heart me-1"></i> Ủng hộ Streamer
                    </a>
                    <a href="/" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                        <i class="fa-solid fa-home me-1"></i> Về trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
