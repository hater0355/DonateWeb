</style>

@section Scripts {
    <script>
        (() => {
            const search = document.getElementById('guideSearch');
            const filters = [...document.querySelectorAll('[data-guide-filter]')];
            const cards = [...document.querySelectorAll('[data-guide-card]')];
            const groups = [...document.querySelectorAll('[data-guide-group]')];
            const emptyState = document.getElementById('guidesNoResults');
            let activeFilter = 'all';

            const normalize = value => (value || '')
                .toLocaleLowerCase('vi-VN')
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .replace(/đ/g, 'd');

            const applyFilter = () => {
                const term = normalize(search.value.trim());
                let visibleCount = 0;

                cards.forEach(card => {
                    const categoryMatches = activeFilter === 'all' || card.dataset.guideCard === activeFilter;
                    const searchableText = normalize(`${card.innerText} ${card.dataset.guideKeywords || ''}`);
                    const textMatches = !term || searchableText.includes(term);
                    const visible = categoryMatches && textMatches;
                    card.classList.toggle('d-none', !visible);
                    if (!visible) card.removeAttribute('open');
                    if (visible) visibleCount++;
                });

                groups.forEach(group => {
                    const hasVisibleCard = [...group.querySelectorAll('[data-guide-card]')].some(card => !card.classList.contains('d-none'));
                    group.classList.toggle('d-none', !hasVisibleCard);
                });
                emptyState.classList.toggle('d-none', visibleCount > 0);
            };

            filters.forEach(button => button.addEventListener('click', () => {
                activeFilter = button.dataset.guideFilter;
                filters.forEach(filter => {
                    const selected = filter === button;
                    filter.classList.toggle('active', selected);
                    filter.setAttribute('aria-pressed', selected ? 'true' : 'false');
                });
                applyFilter();
            }));

            search.addEventListener('input', applyFilter);
            document.addEventListener('keydown', event => {
                if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
                    event.preventDefault();
                    search.focus();
                }
                if (event.key === 'Escape' && document.activeElement === search) {
                    search.value = '';
                    applyFilter();
                    search.blur();
                }
            });
        })();
    </script>
}
