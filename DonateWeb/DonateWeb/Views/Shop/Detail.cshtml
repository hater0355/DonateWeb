@model DonateWeb.Models.Entities.ShopOrder
@{
    ViewData["Title"] = $"Chi tiết đơn hàng #{Model.OrderCode}";
    var isPaid = Model.PaymentStatus == "Paid";
}

<div class="container-fluid px-0 pb-5" style="max-width: 900px;">
    <!-- Nút quay lại -->
    <div class="mb-3 d-flex align-items-center justify-content-between">
        <a href="/Shop/History" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
            <i class="fa-solid fa-arrow-left me-1"></i> Lịch sử đơn hàng
        </a>
        <a href="/Shop" class="btn btn-sm btn-light-green text-dark-green rounded-pill px-3 fw-semibold">
            <i class="fa-solid fa-store me-1"></i> Tiếp tục mua sắm
        </a>
    </div>

    <!-- Hóa đơn / Chi tiết đơn hàng Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <!-- Header -->
        <div class="p-4 bg-dark-green text-white d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill small font-monospace fw-bold mb-2">
                    MÃ ĐƠN: #@Model.OrderCode
                </span>
                <h3 class="fw-bold mb-1">Đơn Hàng Mua Sắm Streamer</h3>
                <div class="text-white-50 small">
                    Ngày đặt: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss") (UTC)
                </div>
            </div>
            <div class="text-end">
                @if (isPaid)
                {
                    <span class="badge bg-success fs-6 px-3 py-2 rounded-pill shadow-sm">
                        <i class="fa-solid fa-circle-check me-1"></i> ĐÃ THANH TOÁN
                    </span>
                    @if (Model.PaidAt.HasValue)
                    {
                        <div class="small text-white-50 mt-1">Lúc: @Model.PaidAt.Value.ToString("HH:mm dd/MM/yyyy")</div>
                    }
                }
                else
                {
                    <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill shadow-sm">
                        <i class="fa-solid fa-clock me-1"></i> CHỜ THANH TOÁN
                    </span>
                }
            </div>
        </div>

        <div class="p-4">
            <!-- Thông tin người mua và Streamer -->
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="p-3 rounded-3 bg-light h-100 border">
                        <h6 class="fw-bold text-dark small text-uppercase mb-2">
                            <i class="fa-solid fa-user me-1 text-success"></i> Thông tin người nhận
                        </h6>
                        <div class="small mb-1"><strong>Họ tên:</strong> @Model.BuyerName</div>
                        <div class="small mb-1"><strong>Điện thoại:</strong> @(string.IsNullOrWhiteSpace(Model.BuyerPhone) ? "Chưa cập nhật" : Model.BuyerPhone)</div>
                        <div class="small mb-1"><strong>Địa chỉ:</strong> @(string.IsNullOrWhiteSpace(Model.BuyerAddress) ? "Chưa cập nhật" : Model.BuyerAddress)</div>
                        @if (!string.IsNullOrWhiteSpace(Model.Note))
                        {
                            <div class="small"><strong>Ghi chú:</strong> <span class="fst-italic">@Model.Note</span></div>
                        }
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 rounded-3 bg-light h-100 border">
                        <h6 class="fw-bold text-dark small text-uppercase mb-2">
                            <i class="fa-solid fa-store me-1 text-primary"></i> Gian hàng Streamer
                        </h6>
                        <div class="small mb-1"><strong>Streamer:</strong> @Model.StreamerProfile.DisplayName</div>
                        <div class="small mb-1"><strong>Phương thức:</strong> 
                            @(Model.PaymentMethod == "Wallet" ? "Ví số dư OnlyFan" : Model.PaymentMethod == "PayOS" ? "PayOS QR" : Model.PaymentMethod == "Coupon" ? "Mã giảm giá" : "VietQR")
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.CouponCode))
                        {
                            <div class="small mb-1"><strong>Mã giảm giá:</strong> <span class="font-monospace text-success">@Model.CouponCode</span></div>
                        }
                        <div class="small mb-1"><strong>Mã giao dịch:</strong> <span class="font-monospace text-muted">@Model.TransactionCode</span></div>
                        <div class="mt-2">
                            <a href="/Shop/StreamerShop?slug=@Model.StreamerProfile.Slug" class="btn btn-sm btn-outline-success rounded-pill px-3">
                                <i class="fa-solid fa-bag-shopping me-1"></i> Ghé lại Shop của Streamer
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Danh sách mặt hàng -->
            <h6 class="fw-bold text-dark small text-uppercase mb-2">
                <i class="fa-solid fa-boxes-stacked me-1 text-secondary"></i> Các mặt hàng trong đơn
            </h6>
            <div class="table-responsive mb-4">
                <table class="table align-middle border">
                    <thead class="bg-light">
                        <tr class="small text-muted text-uppercase">
                            <th class="ps-3 py-2">Sản phẩm</th>
                            <th class="py-2 text-center">Đơn giá</th>
                            <th class="py-2 text-center">Số lượng</th>
                            <th class="pe-3 py-2 text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="fw-bold text-dark">@item.ProductName</div>
                                    <span class="small text-muted font-monospace">Mã SP: #@item.ShopProductId</span>
                                    @if (!string.IsNullOrWhiteSpace(item.VariantSelection))
                                    {
                                        <div class="small text-muted">Lựa chọn: <strong>@item.VariantSelection</strong></div>
                                    }
                                </td>
                                <td class="text-center font-monospace">@item.Price.ToString("N0") đ</td>
                                <td class="text-center font-monospace fw-bold">@item.Quantity</td>
                                <td class="pe-3 text-end fw-bold text-dark-green font-monospace">
                                    @((item.Price * item.Quantity).ToString("N0")) đ
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-light">
                        @if (Model.DiscountAmount > 0 || Model.ShippingFee > 0)
                        {
                            <tr>
                                <td colspan="3" class="text-end small py-2">Tạm tính:</td>
                                <td class="pe-3 text-end font-monospace py-2">@Model.SubtotalAmount.ToString("N0") VNĐ</td>
                            </tr>
                            @if (Model.DiscountAmount > 0)
                            {
                                <tr>
                                    <td colspan="3" class="text-end small text-success py-2">Giảm giá:</td>
                                    <td class="pe-3 text-end fw-semibold text-success font-monospace py-2">-@Model.DiscountAmount.ToString("N0") VNĐ</td>
                                </tr>
                            }
                            @if (Model.ShippingFee > 0)
                            {
                                <tr>
                                    <td colspan="3" class="text-end small py-2">Phí vận chuyển (GHN báo giá test):</td>
                                    <td class="pe-3 text-end font-monospace py-2">+@Model.ShippingFee.ToString("N0") VNĐ</td>
                                </tr>
                            }
                        }
                        <tr>
                            <td colspan="3" class="text-end fw-bold py-3">TỔNG THANH TOÁN:</td>
                            <td class="pe-3 text-end fw-bold text-dark-green fs-5 font-monospace py-3">
                                @Model.TotalAmount.ToString("N0") VNĐ
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Nút hành động -->
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pt-2 border-top">
                <span class="small text-muted">Mọi thắc mắc về đơn hàng vui lòng liên hệ trực tiếp với Streamer hoặc hỗ trợ OnlyFan.</span>
                <button type="button" class="btn btn-outline-secondary rounded-pill px-3" onclick="window.print()">
                    <i class="fa-solid fa-print me-1"></i> In hóa đơn
                </button>
            </div>
        </div>
    </div>
</div>

@if (!isPaid && Model.PaymentMethod == "PayOS")
{
    <div id="payosOrderStatus" class="alert alert-info mt-3" data-order-code="@Model.OrderCode" role="status">
        Đang chờ PayOS xác nhận. Trang này sẽ tự cập nhật khi thanh toán thành công.
    </div>
}

@section Scripts {
    @if (!isPaid && Model.PaymentMethod == "PayOS")
    {
        <script>
            (() => {
                const statusBox = document.getElementById("payosOrderStatus");
                const orderCode = statusBox?.dataset.orderCode;
                if (!statusBox || !orderCode) return;

                let checks = 0;
                let checking = false;
                const timer = window.setInterval(async () => {
                    if (checking) return;
                    checking = true;
                    checks++;
                    try {
                        const response = await fetch(`/Shop/CheckPaymentStatus?orderCode=${encodeURIComponent(orderCode)}`, {
                            cache: "no-store",
                            headers: { "Accept": "application/json" }
                        });
                        if (response.ok) {
                            const result = await response.json();
                            if (result.isPaid) {
                                window.clearInterval(timer);
                                statusBox.className = "alert alert-success mt-3";
                                statusBox.textContent = "PayOS đã xác nhận thanh toán. Đang cập nhật hóa đơn...";
                                window.setTimeout(() => window.location.reload(), 1200);
                            } else if (result.status === "Cancelled") {
                                window.clearInterval(timer);
                                statusBox.className = "alert alert-warning mt-3";
                                statusBox.textContent = "Thanh toán PayOS chưa được tạo. Vui lòng liên hệ gian hàng để được hỗ trợ.";
                            }
                        }
                    } catch (error) {
                        console.warn("Không kiểm tra được trạng thái đơn hàng:", error);
                    } finally {
                        checking = false;
                        if (checks >= 200) {
                            window.clearInterval(timer);
                            if (statusBox.classList.contains("alert-info")) {
                                statusBox.textContent = "Chưa nhận được xác nhận. Tải lại trang sau ít phút để kiểm tra trạng thái.";
                            }
                        }
                    }
                }, 3000);
            })();
        </script>
    }
}
