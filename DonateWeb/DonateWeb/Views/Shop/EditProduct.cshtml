@model DonateWeb.ViewModels.Shop.ProductInputModel
@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="container py-4" style="max-width: 900px;">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark-green mb-1">Sửa sản phẩm</h2>
            <p class="text-muted mb-0">Thông tin sản phẩm đã sửa sẽ được Admin duyệt lại trước khi bán tiếp.</p>
        </div>
        <a asp-controller="Shop" asp-action="MyProducts" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="fa-solid fa-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-dark-green text-white p-3 fw-bold">
            <i class="fa-regular fa-pen-to-square text-warning me-2"></i>Thông tin bán hàng
        </div>
        <div class="card-body p-4">
            <div class="alert alert-info rounded-3 small">
                Thay đổi tên, giá, mô tả hoặc ảnh sẽ chuyển sản phẩm về trạng thái <strong>Chờ Admin duyệt</strong>. Sản phẩm tạm ẩn khỏi gian hàng trong lúc xét duyệt.
            </div>

            <form asp-controller="Shop" asp-action="EditProduct" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />
                <input asp-for="StockQuantity" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-12 col-md-8">
                        <label asp-for="Name" class="form-label fw-semibold">Tên sản phẩm</label>
                        <input asp-for="Name" class="form-control" maxlength="200" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-4">
                        <label asp-for="Price" class="form-label fw-semibold">Giá bán (VNĐ)</label>
                        <input asp-for="Price" type="number" min="1000" max="1000000000" step="1000" class="form-control" required />
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold">Mô tả sản phẩm</label>
                        <textarea asp-for="Description" class="form-control" rows="4" maxlength="2000"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="col-12 col-md-7">
                        <label asp-for="ImageUrl" class="form-label fw-semibold">Đường dẫn ảnh</label>
                        <input asp-for="ImageUrl" type="url" class="form-control" maxlength="500" id="imageUrlInput" />
                        <div class="form-text">Giữ nguyên đường dẫn để giữ ảnh hiện tại, hoặc nhập URL ảnh mới.</div>
                    </div>
                    <div class="col-12 col-md-5">
                        <label asp-for="ImageFile" class="form-label fw-semibold">Hoặc tải ảnh mới</label>
                        <input asp-for="ImageFile" type="file" accept="image/*" class="form-control" id="imageFileInput" />
                        <span asp-validation-for="ImageFile" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <div class="border rounded-3 bg-light p-3 text-center">
                            <img id="imagePreview" src="@(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "/images/default-banner.jpg" : Model.ImageUrl)"
                                 alt="Ảnh sản phẩm" style="max-width: 100%; max-height: 260px; object-fit: contain;"
                                 onerror="this.src='/images/default-banner.jpg';" />
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-controller="Shop" asp-action="MyProducts" class="btn btn-light rounded-pill px-4">Hủy</a>
                    <button type="submit" class="btn btn-dark-green rounded-pill px-4 fw-bold">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    const imagePreview = document.getElementById('imagePreview');
    document.getElementById('imageUrlInput')?.addEventListener('input', event => {
        if (event.target.value.trim()) imagePreview.src = event.target.value.trim();
    });
    document.getElementById('imageFileInput')?.addEventListener('change', event => {
        const file = event.target.files?.[0];
        if (file) imagePreview.src = URL.createObjectURL(file);
    });
</script>
