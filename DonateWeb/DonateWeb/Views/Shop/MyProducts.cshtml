@model DonateWeb.ViewModels.Shop.ProductManageViewModel
@{
    ViewData["Title"] = "Quản lý Sản phẩm Gian hàng";
}

<style>
    .product-mgmt-header {
        background: linear-gradient(135deg, #1b4533 0%, #29503e 100%);
        border-radius: 20px;
        color: white;
        padding: 28px 32px;
        box-shadow: 0 8px 24px rgba(27, 69, 51, 0.15);
    }
    .preview-box {
        width: 100%;
        height: 180px;
        border-radius: 12px;
        border: 2px dashed #cbd5e1;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8fafc;
        overflow: hidden;
        position: relative;
    }
    .preview-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .product-size-checkboxes label { cursor: pointer; }
    .product-size-checkboxes label:has(input:checked) { background: #198754; border-color: #198754; color: #fff; }
</style>

<div class="container-fluid px-0 pb-5">
    <!-- Header Banner -->
    <div class="product-mgmt-header mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-2" style="background: rgba(255,255,255,0.15); font-size: 0.82rem;">
                    <i class="fa-solid fa-boxes-stacked text-warning"></i>
                    <span>Kênh Streamer: @Model.StreamerName</span>
                </div>
                <h2 class="fw-bold mb-1 display-6">Quản Lý Sản Phẩm Gian Hàng</h2>
                <p class="mb-0 text-white-50 small">
                    Chỉ Streamer đã được Admin phê duyệt mới được quản lý gian hàng. Sản phẩm mới hoặc thông tin bán hàng vừa chỉnh sửa sẽ chờ Admin duyệt trước khi hiển thị. Phí nền tảng là 30%; bạn nhận 70% số tiền khách thực trả sau mã giảm giá.
                </p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Shop" asp-action="StreamerShop" asp-route-slug="@Model.StreamerSlug" class="btn btn-outline-light rounded-pill px-3 py-2 fw-semibold" target="_blank">
                    <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Xem gian hàng của bạn
                </a>
                <button type="button" class="btn btn-warning rounded-pill px-4 py-2 fw-bold text-dark shadow-sm" data-bs-toggle="modal" data-bs-target="#addProductModal">
                    <i class="fa-solid fa-circle-plus me-1"></i> Thêm sản phẩm mới
                </button>
            </div>
        </div>
    </div>

    <!-- Alert thông báo -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-4 d-flex align-items-center gap-2 p-3 mb-4 shadow-sm">
            <i class="fa-solid fa-circle-check fs-5 text-success"></i>
            <div class="fw-semibold">@TempData["SuccessMessage"]</div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger rounded-4 d-flex align-items-center gap-2 p-3 mb-4 shadow-sm">
            <i class="fa-solid fa-triangle-exclamation fs-5 text-danger"></i>
            <div class="fw-semibold">@TempData["ErrorMessage"]</div>
        </div>
    }

    <!-- THANH BỘ LỌC TRẠNG THÁI DUYỆT -->
    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
        <a href="/Shop/MyProducts?status=all" class="btn btn-sm rounded-pill px-3 fw-semibold @(Model.StatusFilter == "all" ? "btn-dark" : "btn-outline-secondary")">
            Tất cả (@Model.TotalCount)
        </a>
        <a href="/Shop/MyProducts?status=pending" class="btn btn-sm rounded-pill px-3 fw-semibold @(Model.StatusFilter == "pending" ? "btn-warning text-dark fw-bold shadow-sm" : "btn-outline-warning text-dark")">
            <i class="fa-solid fa-clock me-1 text-warning"></i> Chờ duyệt (@Model.PendingCount)
        </a>
        <a href="/Shop/MyProducts?status=approved" class="btn btn-sm rounded-pill px-3 fw-semibold @(Model.StatusFilter == "approved" ? "btn-success shadow-sm" : "btn-outline-success")">
            <i class="fa-solid fa-circle-check me-1"></i> Đã duyệt / Đang bán (@Model.ApprovedCount)
        </a>
        @if (Model.RejectedCount > 0)
        {
            <a href="/Shop/MyProducts?status=rejected" class="btn btn-sm rounded-pill px-3 fw-semibold @(Model.StatusFilter == "rejected" ? "btn-danger shadow-sm" : "btn-outline-danger")">
                <i class="fa-solid fa-circle-xmark me-1"></i> Bị từ chối (@Model.RejectedCount)
            </a>
        }
        @if (Model.DeletedCount > 0)
        {
            <a href="/Shop/MyProducts?status=hidden" class="btn btn-sm rounded-pill px-3 fw-semibold @(Model.StatusFilter == "hidden" || Model.StatusFilter == "deleted" ? "btn-secondary text-white shadow-sm" : "btn-outline-secondary")">
                <i class="fa-solid fa-eye-slash me-1"></i> Đã ẩn (@Model.DeletedCount)
            </a>
        }
    </div>

    <!-- Danh sách sản phẩm của Streamer -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="p-3 px-4 border-bottom d-flex align-items-center justify-content-between">
            <h5 class="fw-bold text-dark-green mb-0 d-flex align-items-center gap-2">
                <i class="fa-solid fa-list-check text-success"></i>
                Danh Sách Sản Phẩm
                <span class="badge bg-light-green text-dark-green rounded-pill font-monospace">@Model.Products.Count sản phẩm</span>
            </h5>
            <button type="button" class="btn btn-sm btn-dark-green rounded-pill px-3 fw-semibold" data-bs-toggle="modal" data-bs-target="#addProductModal">
                <i class="fa-solid fa-plus me-1"></i> Thêm mới
            </button>
        </div>

        @if (!Model.Products.Any())
        {
            <div class="text-center py-5">
                <i class="fa-solid fa-boxes-packing fa-3x text-muted mb-3 opacity-50"></i>
                <h5 class="fw-bold text-dark">Chưa có sản phẩm nào trong mục này</h5>
                <p class="text-muted small mb-3">Bấm nút bên dưới để tạo sản phẩm mới và gửi Quản trị viên duyệt!</p>
                <button type="button" class="btn btn-dark-green rounded-pill px-4 fw-semibold" data-bs-toggle="modal" data-bs-target="#addProductModal">
                    <i class="fa-solid fa-circle-plus me-1"></i> Thêm sản phẩm mới
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="text-muted small text-uppercase">
                            <th class="ps-4 py-3" style="width: 80px;">Hình ảnh</th>
                            <th class="py-3">Tên sản phẩm</th>
                            <th class="py-3">Danh mục</th>
                            <th class="py-3">Giá bán</th>
                            <th class="py-3">Tồn kho</th>
                            <th class="py-3">Kiểm duyệt Admin</th>
                            <th class="py-3">Ngày gửi</th>
                            <th class="pe-4 py-3 text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prod in Model.Products)
                        {
                            <tr>
                                <td class="ps-4">
                                    <img src="@(string.IsNullOrWhiteSpace(prod.ImageUrl) ? "/images/default-banner.jpg" : prod.ImageUrl)" 
                                         alt="@prod.Name" 
                                         class="rounded-3 border" 
                                         style="width: 56px; height: 56px; object-fit: cover;" 
                                         onerror="this.src='/images/default-banner.jpg';" />
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@prod.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(prod.Description))
                                    {
                                        <div class="text-muted small text-truncate" style="max-width: 320px;">@prod.Description</div>
                                    }
                                    @if (prod.WeightGrams.HasValue && prod.LengthCm.HasValue && prod.WidthCm.HasValue && prod.HeightCm.HasValue)
                                    {
                                        <div class="text-muted small mt-1">
                                            <i class="fa-solid fa-box me-1"></i>@prod.WeightGrams g · @prod.LengthCm × @prod.WidthCm × @prod.HeightCm cm
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-warning-emphasis small mt-1"><i class="fa-solid fa-triangle-exclamation me-1"></i>Chưa có thông số kiện hàng</div>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border">@prod.Category</span></td>
                                <td>
                                            @if (prod.Variants.Count > 0)
                                            {
                                                <span class="fw-bold text-dark-green font-monospace fs-6">Từ @prod.Price.ToString("N0") đ</span>
                                                <div class="small text-muted">@prod.Variants.Count lựa chọn</div>
                                            }
                                            else
                                            {
                                                <span class="fw-bold text-dark-green font-monospace fs-6">@prod.Price.ToString("N0") đ</span>
                                            }
                                </td>
                                <td>
                                    @if (prod.IsActive && prod.Variants.Count == 0)
                                    {
                                        <form asp-controller="Shop" asp-action="UpdateStock" method="post" class="d-flex align-items-center gap-1">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@prod.Id" />
                                            <input type="number" name="stockQuantity" value="@prod.StockQuantity" min="0" max="999999"
                                                   class="form-control form-control-sm font-monospace" style="width: 92px" aria-label="Tồn kho của @prod.Name" />
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Lưu tồn kho" aria-label="Lưu tồn kho">
                                                <i class="fa-solid fa-floppy-disk"></i>
                                            </button>
                                        </form>
                                        @if (prod.StockQuantity == 0)
                                        {
                                            <span class="small text-danger">Hết hàng</span>
                                        }
                                    }
                                    else if (prod.IsActive)
                                    {
                                        <div class="small">
                                            @foreach (var variant in prod.Variants)
                                            {
                                                <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                                                    <span class="text-truncate">@variant.Name · @variant.Price.ToString("N0") đ</span>
                                                    <span class="badge @(variant.StockQuantity > 0 ? "bg-light text-dark border" : "bg-danger-subtle text-danger")">Kho @variant.StockQuantity</span>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Đã lưu trữ</span>
                                    }
                                </td>
                                <td>
                                    @if (!prod.IsActive)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border px-2 py-1 rounded-pill small fw-semibold">
                                            <i class="fa-solid fa-eye-slash me-1"></i> Đã ẩn khỏi gian hàng
                                        </span>
                                        <div class="text-muted small mt-1" style="font-size: 0.75rem;">Có thể hiện lại; đơn cũ vẫn được giữ</div>
                                    }
                                    else if (prod.ApprovalStatus == DonateWeb.Models.Enums.ProductApprovalStatus.Pending)
                                    {
                                        <span class="badge bg-warning-subtle text-dark border border-warning px-2 py-1 rounded-pill small fw-semibold">
                                            <i class="fa-solid fa-clock me-1 text-warning"></i> Chờ Admin duyệt
                                        </span>
                                        <div class="text-muted small mt-1" style="font-size: 0.75rem;">Chưa hiển thị trên gian hàng</div>
                                    }
                                    else if (prod.ApprovalStatus == DonateWeb.Models.Enums.ProductApprovalStatus.Approved)
                                    {
                                        if (prod.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill small fw-semibold">
                                                <i class="fa-solid fa-circle-check me-1"></i> Đã duyệt (Đang bán)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary px-2 py-1 rounded-pill small fw-semibold">
                                                Đã duyệt (Tạm ngưng)
                                            </span>
                                        }
                                    }
                                    else if (prod.ApprovalStatus == DonateWeb.Models.Enums.ProductApprovalStatus.Rejected)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 rounded-pill small fw-semibold">
                                            <i class="fa-solid fa-circle-xmark me-1"></i> Bị từ chối duyệt
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(prod.RejectionReason))
                                        {
                                            <div class="text-danger small mt-1" style="font-size: 0.78rem;">
                                                <i class="fa-solid fa-circle-info me-1"></i> Lý do: @prod.RejectionReason
                                            </div>
                                        }
                                    }
                                </td>
                                <td>
                                    <span class="small text-muted">@prod.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                </td>
                                <td class="pe-4 text-end text-nowrap">
                                    @if (prod.IsActive)
                                    {
                                        <a asp-controller="Shop" asp-action="EditProduct" asp-route-id="@prod.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1">
                                            <i class="fa-regular fa-pen-to-square me-1"></i> Sửa
                                        </a>
                                        <form asp-controller="Shop" asp-action="DeleteProduct" method="post" class="d-inline" onsubmit="return confirm('Ẩn sản phẩm này khỏi gian hàng? Bạn có thể hiện lại sau.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@prod.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Ẩn sản phẩm khỏi gian hàng">
                                                <i class="fa-solid fa-eye-slash me-1"></i> Ẩn
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="Shop" asp-action="RestoreProduct" method="post" class="d-inline" onsubmit="return confirm('Hiện lại sản phẩm này trong gian hàng?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@prod.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3" title="Hiện lại sản phẩm">
                                                <i class="fa-solid fa-eye me-1"></i> Hiện lại
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- MODAL THÊM SẢN PHẨM MỚI -->
<div class="modal fade" id="addProductModal" tabindex="-1" aria-labelledby="addProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <form asp-controller="Shop" asp-action="CreateProduct" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-dark-green text-white py-3 border-0">
                    <h5 class="modal-title fw-bold fs-6 d-flex align-items-center gap-2" id="addProductModalLabel">
                        <i class="fa-solid fa-circle-plus text-warning"></i>
                        Thêm Sản Phẩm Mới Vào Gian Hàng
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="alert alert-warning border-0 rounded-3 small p-3 mb-3 d-flex align-items-center gap-2" style="background-color: #fef3c7;">
                        <i class="fa-solid fa-shield-halved text-warning fs-5"></i>
                        <div>
                            <strong>Quy trình kiểm duyệt:</strong> Sản phẩm sau khi thêm sẽ được gửi đến <strong>Quản trị viên (Admin) xét duyệt</strong> để đảm bảo an toàn nội dung trước khi xuất hiện trên gian hàng công khai.
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- Tên sản phẩm -->
                        <div class="col-12 col-md-8">
                            <label class="form-label fw-semibold text-dark small">Tên sản phẩm <span class="text-danger">*</span></label>
                            <input type="text" name="Name" class="form-control rounded-3" placeholder="Ví dụ: Áo Thun Mixi Gaming Bản Giới Hạn 2026" required maxlength="200" />
                        </div>

                        <div class="col-12 col-md-4">
                            <label for="newProductCategory" class="form-label fw-semibold text-dark small">Danh mục <span class="text-danger">*</span></label>
                            <select id="newProductCategory" name="Category" class="form-select rounded-3 product-category-select" required>
                                <option value="">-- Chọn danh mục --</option>
                                @foreach (var category in DonateWeb.ViewModels.Shop.ShopProductCategories.All)
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 d-none product-size-options" data-prefix="newProduct">
                            <label class="form-label fw-semibold text-dark small mb-1">Size có sẵn cho người mua chọn</label>
                            <div class="product-size-checkboxes d-flex flex-wrap gap-2"></div>
                            <div class="form-text">Cách nhanh: chọn size dùng chung giá và tồn kho. Muốn giá/tồn kho riêng từng size thì khai báo S, M, L trong bảng lựa chọn bên dưới.</div>
                        </div>

                        <div class="col-12">
                            <div class="border rounded-3 p-3 bg-light-subtle">
                                <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                                    <div>
                                        <label class="form-label fw-semibold text-dark small mb-0">Lựa chọn bán hàng (không bắt buộc)</label>
                                        <div class="form-text">Ví dụ: 1 hộp, 2 hộp, 3 hộp; mỗi lựa chọn có giá và tồn kho riêng. Số gói tính ship đặt tương ứng 1, 2, 3.</div>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-success rounded-pill add-product-variant" data-target="newProductVariants" data-base-price="newProductPrice" data-base-stock="newProductStock">
                                        <i class="fa-solid fa-plus me-1"></i> Thêm lựa chọn
                                    </button>
                                </div>
                                <div id="newProductVariants" class="d-grid gap-2 mt-3"></div>
                                <div class="form-text mt-2">Khi có lựa chọn, khách bắt buộc chọn một lựa chọn trước khi mua. Giá và kho tổng được tính từ các lựa chọn.</div>
                            </div>
                        </div>

                        <!-- Giá bán -->
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold text-dark small">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" id="newProductPrice" name="Price" class="form-control rounded-start-3" placeholder="250000" min="0" max="1000000000" step="1000" />
                                <span class="input-group-text bg-light rounded-end-3">VNĐ</span>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="fw-semibold text-dark small">Thông số kiện hàng cho một sản phẩm <span class="text-danger">*</span></div>
                            <div class="form-text">Nhập cân nặng và kích thước sau khi đóng gói để web tính phí vận chuyển. Dùng gram và centimet.</div>
                        </div>
                        <div class="col-12 col-md-3">
                            <label for="newProductWeightGrams" class="form-label small">Cân nặng (gram)</label>
                            <input type="number" id="newProductWeightGrams" name="WeightGrams" class="form-control rounded-3" min="1" max="100000" step="1" required />
                        </div>
                        <div class="col-12 col-md-3">
                            <label for="newProductLengthCm" class="form-label small">Dài (cm)</label>
                            <input type="number" id="newProductLengthCm" name="LengthCm" class="form-control rounded-3" min="1" max="200" step="1" required />
                        </div>
                        <div class="col-12 col-md-3">
                            <label for="newProductWidthCm" class="form-label small">Rộng (cm)</label>
                            <input type="number" id="newProductWidthCm" name="WidthCm" class="form-control rounded-3" min="1" max="200" step="1" required />
                        </div>
                        <div class="col-12 col-md-3">
                            <label for="newProductHeightCm" class="form-label small">Cao (cm)</label>
                            <input type="number" id="newProductHeightCm" name="HeightCm" class="form-control rounded-3" min="1" max="200" step="1" required />
                        </div>

                        <!-- Số lượng tồn kho -->
                        <div class="col-12 col-md-4">
                            <label class="form-label fw-semibold text-dark small">Số lượng tồn kho</label>
                            <input type="number" id="newProductStock" name="StockQuantity" class="form-control rounded-3" value="100" min="0" max="999999" />
                            <div class="form-text">Chỉ dùng khi không khai báo lựa chọn riêng.</div>
                        </div>

                        <!-- Chọn hình ảnh từ máy tính (File Upload) -->
                        <div class="col-12 col-md-8">
                            <label class="form-label fw-semibold text-dark small">
                                <i class="fa-solid fa-upload me-1 text-success"></i> Chọn ảnh sản phẩm từ máy tính <span class="text-danger">*</span>
                            </label>
                            <input type="file" id="productImageFileInput" name="ImageFile" class="form-control rounded-3" accept="image/jpeg,image/png,image/webp,image/gif" onchange="previewSelectedImage(event)" />
                            <div class="form-text small">Hỗ trợ JPG, PNG, WebP (Tối đa 8 MB).</div>
                        </div>

                        <!-- Hoặc nhập link ảnh URL dự phòng -->
                        <div class="col-12">
                            <label class="form-label fw-semibold text-dark small">Hoặc đường dẫn ảnh Online (URL)</label>
                            <input type="url" id="productImageUrlInput" name="ImageUrl" class="form-control rounded-3" placeholder="https://example.com/anh-san-pham.jpg" oninput="previewUrlImage(this.value)" />
                        </div>

                        <!-- Khung xem trước ảnh (Preview) -->
                        <div class="col-12">
                            <label class="form-label fw-semibold text-dark small mb-1">Xem trước hình ảnh:</label>
                            <div class="preview-box">
                                <img id="productImagePreview" src="/images/default-banner.jpg" alt="Preview" />
                            </div>
                        </div>

                        <!-- Mô tả sản phẩm -->
                        <div class="col-12">
                            <label class="form-label fw-semibold text-dark small">Mô tả chi tiết sản phẩm</label>
                            <textarea name="Description" class="form-control rounded-3" rows="3" placeholder="Mô tả chất liệu, màu sắc, kích thước, ưu điểm nổi bật của sản phẩm..." maxlength="2000"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold text-dark small"><i class="fa-regular fa-images me-1 text-success"></i>Ảnh phụ bên dưới phần mô tả</label>
                            <input type="file" name="AdditionalImageFiles" class="form-control rounded-3 additional-product-images" accept="image/jpeg,image/png,image/webp,image/gif" multiple />
                            <div class="form-text">Tải tối đa 4 ảnh phụ, mỗi ảnh tối đa 8 MB. Ảnh sẽ xuất hiện trong thư viện ảnh của sản phẩm.</div>
                            <div class="additional-image-preview d-flex flex-wrap gap-2 mt-2"></div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light border-0 py-3">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-dark-green rounded-pill px-4 fw-bold">
                        <i class="fa-solid fa-check me-1"></i> Thêm Sản Phẩm Ngay
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function previewSelectedImage(event) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('productImagePreview').src = e.target.result;
            };
            reader.readAsDataURL(file);
        }
    }

    function previewUrlImage(url) {
        if (url && url.trim().length > 5) {
            document.getElementById('productImagePreview').src = url.trim();
        }
    }

    (() => {
        const clothingSizes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(DonateWeb.ViewModels.Shop.ShopProductCategories.ClothingSizes));
        const footwearSizes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(DonateWeb.ViewModels.Shop.ShopProductCategories.FootwearSizes));
        const clothingCategory = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(DonateWeb.ViewModels.Shop.ShopProductCategories.Clothing));
        const footwearCategory = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(DonateWeb.ViewModels.Shop.ShopProductCategories.Footwear));
        const sizePanel = document.querySelector('.product-size-options[data-prefix="newProduct"]');
        const categorySelect = document.getElementById('newProductCategory');
        const checkboxContainer = sizePanel?.querySelector('.product-size-checkboxes');

        function renderSizes(selected = []) {
            const values = categorySelect.value === clothingCategory ? clothingSizes
                : categorySelect.value === footwearCategory ? footwearSizes : [];
            sizePanel.classList.toggle('d-none', values.length === 0);
            checkboxContainer.innerHTML = values.map((size, index) => {
                const id = `newProductSize${index}`;
                return `<label class="btn btn-outline-secondary btn-sm rounded-pill" for="${id}">
                    <input class="visually-hidden" type="checkbox" id="${id}" name="AvailableSizes" value="${size}" ${selected.includes(size) ? 'checked' : ''} />${size}</label>`;
            }).join('');
        }

        categorySelect?.addEventListener('change', () => renderSizes());
        renderSizes();
        checkboxContainer?.addEventListener('change', event => {
            if (event.target.matches('input[type="checkbox"]') && event.target.checked
                && document.getElementById('newProductVariants')?.querySelector('[data-product-variant-row]')) {
                event.target.checked = false;
                alert('Dùng size nhanh hoặc bảng giá/tồn kho riêng bên dưới; không chọn đồng thời hai kiểu.');
            }
        });

        function reindexVariantRows(container) {
            Array.from(container.querySelectorAll('[data-product-variant-row]')).forEach((row, index) => {
                row.querySelectorAll('[data-variant-field]').forEach(input => {
                    input.name = `Variants[${index}].${input.dataset.variantField}`;
                });
            });
        }

        document.querySelectorAll('.add-product-variant').forEach(button => button.addEventListener('click', () => {
            const container = document.getElementById(button.dataset.target);
            const basePrice = document.getElementById(button.dataset.basePrice);
            const baseStock = document.getElementById(button.dataset.baseStock);
            if (!container) return;
            sizePanel?.querySelectorAll('input[type="checkbox"]:checked').forEach(input => input.checked = false);
            const row = document.createElement('div');
            row.className = 'row g-2 align-items-end border rounded-3 p-2 mx-0';
            row.dataset.productVariantRow = 'true';
            row.innerHTML = `
                <div class="col-12 col-md-3"><label class="form-label small mb-1">Tên lựa chọn</label><input data-variant-field="Name" class="form-control form-control-sm" maxlength="50" placeholder="Ví dụ: 2 hộp" required /></div>
                <div class="col-6 col-md-3"><label class="form-label small mb-1">Giá (VNĐ)</label><input data-variant-field="Price" type="number" class="form-control form-control-sm" min="1000" max="1000000000" step="1000" value="${basePrice?.value || ''}" required /></div>
                <div class="col-6 col-md-2"><label class="form-label small mb-1">Tồn kho</label><input data-variant-field="StockQuantity" type="number" class="form-control form-control-sm" min="0" max="999999" value="${baseStock?.value || '0'}" required /></div>
                <div class="col-6 col-md-2"><label class="form-label small mb-1">Số gói tính ship</label><input data-variant-field="ShippingUnits" type="number" class="form-control form-control-sm" min="1" max="100" value="1" required /></div>
                <div class="col-6 col-md-2 d-grid"><button type="button" class="btn btn-sm btn-outline-danger remove-product-variant"><i class="fa-solid fa-trash"></i> Bỏ</button></div>`;
            container.appendChild(row);
            reindexVariantRows(container);
        }));

        document.addEventListener('click', event => {
            const remove = event.target.closest('.remove-product-variant');
            if (!remove) return;
            const container = remove.closest('.variant-list');
            const rowContainer = remove.closest('#newProductVariants');
            const target = container || rowContainer;
            remove.closest('[data-product-variant-row]')?.remove();
            if (target) reindexVariantRows(target);
        });

        document.querySelector('.additional-product-images')?.addEventListener('change', event => {
            const files = Array.from(event.target.files || []);
            const preview = document.querySelector('.additional-image-preview');
            if (files.length > 4) {
                alert('Bạn chỉ có thể tải tối đa 4 ảnh phụ.');
                event.target.value = '';
                preview.innerHTML = '';
                return;
            }
            preview.innerHTML = files.map(file => `<img src="${URL.createObjectURL(file)}" alt="Ảnh xem trước" class="rounded border" style="width:76px;height:76px;object-fit:cover">`).join('');
        });
    })();
</script>
