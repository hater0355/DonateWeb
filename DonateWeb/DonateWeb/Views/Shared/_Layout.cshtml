<!-- FILE: Views/Shared/_Layout.cshtml -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ONLY FAN</title>
    <!-- Dùng thư viện lưu cùng ứng dụng để tránh trình duyệt phải chờ CDN bên ngoài. -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/support-chat.css" asp-append-version="true" />
</head>
@{
    var isWidgetsArea = string.Equals(ViewContext.RouteData.Values["area"]?.ToString(), "Widgets", StringComparison.OrdinalIgnoreCase);
    var isSupportChatVisitor = !isWidgetsArea && !User.IsInRole(DonateWeb.Models.Enums.UserRoles.Admin)
        && !User.IsInRole(DonateWeb.Models.Enums.UserRoles.SupportAgent);
}
<body class="@(isWidgetsArea ? "desktop-widget-layout" : "")">
    <div class="animated-bg-container">
        <div class="moving-bar bar-1"></div>
        <div class="moving-bar bar-2"></div>
        <div class="moving-bar bar-3"></div>
    </div>
    @await Html.PartialAsync("_Header")
    @if (!isWidgetsArea)
    {
        @await Html.PartialAsync("_MobileNavigation")
    }
    @if (isSupportChatVisitor)
    {
        @await Html.PartialAsync("_SupportChatWidget")
    }

    <div class="d-flex main-wrapper">
        @await Html.PartialAsync("_Sidebar")
        
        <main class="main-content flex-grow-1 p-4">
            @await Html.PartialAsync("_BreakingNews")
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (isSupportChatVisitor)
    {
        <script src="~/js/support-chat.js" asp-append-version="true"></script>
    }
    @if (User.IsInRole(DonateWeb.Models.Enums.UserRoles.Admin) || User.IsInRole(DonateWeb.Models.Enums.UserRoles.SupportAgent))
    {
        <script src="~/js/support-chat-inbox.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
