@model DonateWeb.Areas.Admin.ViewModels.AdminTransactionListViewModel
@{
    ViewData["Title"] = "Tra Cứu & Kiểm Tra Log Giao Dịch / Khiếu Nại (Dispute)";
}

<!-- FILE: Areas/Admin/Views/Admin/Transactions.cshtml -->
<!-- CHỨC NĂNG: TRA CỨU VÀ KIỂM TRA LOG GIAO DỊCH KHI CÓ KHIẾU NẠI (DISPUTE/LỖI GIAO DỊCH) -->

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-file-shield text-warning me-2"></i>Tra Cứu & Kiểm Tra Log Giao Dịch
        </h4>
        <p class="text-muted small mb-0">Đối soát lịch sử chuyển tiền, xử lý khiếu nại (dispute) và kiểm tra nhật ký vết giao dịch (Audit Trail)</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/Admin/Transactions?isDisputed=true" class="btn btn-outline-danger btn-sm rounded-pill px-3 @(Model.IsDisputedFilter == true ? "active" : "")">
            <i class="fa-solid fa-triangle-exclamation me-1"></i> Lọc nhanh Khiếu nại (Dispute)
        </a>
    </div>
</div>

<!-- KHUNG TÌM KIẾM VÀ BỘ LỌC ĐA TIÊU CHÍ -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <!-- 1. Tìm kiếm từ khóa -->
            <div class="col-12 col-md-3">
                <label class="form-label small fw-semibold text-muted mb-1">Từ khóa tìm kiếm:</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" name="search" class="form-control border-start-0 ps-0" 
                           placeholder="Mã GD, Tên người gửi, Streamer..." 
                           value="@Model.SearchCodeOrDonor" />
                </div>
            </div>

            <!-- 2. Lọc trạng thái -->
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Trạng thái:</label>
                <select name="status" class="form-select">
                    <option value="">-- Tất cả --</option>
                    <option value="0" selected="@(Model.StatusFilter == 0)">Đang chờ (Pending)</option>
                    <option value="1" selected="@(Model.StatusFilter == 1)">Thành công (Success)</option>
                    <option value="2" selected="@(Model.StatusFilter == 2)">Thất bại (Failed)</option>
                    <option value="3" selected="@(Model.StatusFilter == 3)">Đã hủy (Cancelled)</option>
                    <option value="4" selected="@(Model.StatusFilter == 4)">Đang khiếu nại (Disputed)</option>
                    <option value="5" selected="@(Model.StatusFilter == 5)">Đã hoàn tiền (Refunded)</option>
                </select>
            </div>

            <!-- 3. Lọc phương thức thanh toán -->
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Phương thức:</label>
                <select name="paymentMethod" class="form-select">
                    <option value="">-- Tất cả --</option>
                    <option value="1" selected="@(Model.PaymentMethodFilter == 1)">Ví DonateWeb</option>
                    <option value="2" selected="@(Model.PaymentMethodFilter == 2)">Chuyển khoản QR</option>
                    <option value="3" selected="@(Model.PaymentMethodFilter == 3)">MoMo</option>
                    <option value="4" selected="@(Model.PaymentMethodFilter == 4)">VNPay</option>
                </select>
            </div>

            <!-- 4. Lọc cờ Khiếu nại -->
            <div class="col-6 col-md-2">
                <label class="form-label small fw-semibold text-muted mb-1">Khiếu nại (Dispute):</label>
                <select name="isDisputed" class="form-select">
                    <option value="">-- Tất cả GD --</option>
                    <option value="true" selected="@(Model.IsDisputedFilter == true)">Có khiếu nại</option>
                    <option value="false" selected="@(Model.IsDisputedFilter == false)">Không khiếu nại</option>
                </select>
            </div>

            <!-- 5. Nút tìm kiếm & Đặt lại -->
            <div class="col-6 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="fa-solid fa-filter me-1"></i> Tra cứu
                </button>
                <a href="/Admin/Transactions" class="btn btn-outline-secondary" title="Đặt lại bộ lọc">
                    <i class="fa-solid fa-rotate-right"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- THANH THỐNG KÊ KẾT QUẢ LỌC -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="small text-muted">
        Tìm thấy <strong>@Model.TotalRecords</strong> giao dịch | Tổng số tiền: <strong class="text-success">@Model.FilteredTotalAmount.ToString("N0") VNĐ</strong>
    </div>

    @if (Model.IsDisputedFilter == true)
    {
        <div class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">
            <i class="fa-solid fa-triangle-exclamation me-1"></i> Đang hiển thị danh sách các giao dịch có KHIẾU NẠI / LỖI
        </div>
    }
</div>

<!-- BẢNG DANH SÁCH GIAO DỊCH VÀ AUDIT LOGS -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="small text-muted text-uppercase">
                        <th>Mã Giao Dịch</th>
                        <th>Người Ủng Hộ</th>
                        <th>Kênh Nhận (Streamer)</th>
                        <th class="text-end">Số Tiền</th>
                        <th>Phương Thức</th>
                        <th class="text-center">Trạng Thái</th>
                        <th>Khiếu Nại / Log</th>
                        <th>Thời Gian</th>
                        <th class="text-center">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Transactions.Any())
                    {
                        foreach (var tx in Model.Transactions)
                        {
                            <tr class="@(tx.IsDisputed ? "table-warning-subtle" : "")">
                                <!-- Mã GD -->
                                <td>
                                    <span class="font-monospace fw-bold text-dark">@tx.TransactionCode</span>
                                </td>

                                <!-- Người gửi -->
                                <td>
                                    <div class="fw-semibold text-dark">@tx.DonorName</div>
                                    @if (!string.IsNullOrEmpty(tx.Message))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width: 160px;" title="@tx.Message">
                                            "@tx.Message"
                                        </div>
                                    }
                                </td>

                                <!-- Streamer -->
                                <td>
                                    <div class="fw-semibold text-primary">@tx.StreamerDisplayName</div>
                                    <span class="small text-muted">/@tx.StreamerSlug</span>
                                </td>

                                <!-- Số tiền -->
                                <td class="text-end fw-bold text-success">
                                    @tx.Amount.ToString("N0") đ
                                </td>

                                <!-- Phương thức -->
                                <td>
                                    @switch (tx.PaymentMethod)
                                    {
                                        case PaymentMethod.Wallet:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="fa-solid fa-wallet me-1"></i>Ví Donate</span>
                                            break;
                                        case PaymentMethod.BankTransfer:
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle"><i class="fa-solid fa-qrcode me-1"></i>VietQR</span>
                                            break;
                                        case PaymentMethod.Momo:
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="fa-solid fa-mobile-screen me-1"></i>MoMo</span>
                                            break;
                                        case PaymentMethod.VnPay:
                                            <span class="badge bg-info-subtle text-info border border-info-subtle"><i class="fa-solid fa-credit-card me-1"></i>VNPay</span>
                                            break;
                                    }
                                </td>

                                <!-- Trạng thái -->
                                <td class="text-center">
                                    @switch (tx.Status)
                                    {
                                        case DonationStatus.Success:
                                            <span class="badge bg-success text-white px-2 py-1 rounded-pill">Thành công</span>
                                            break;
                                        case DonationStatus.Pending:
                                            <span class="badge bg-warning text-dark px-2 py-1 rounded-pill">Chờ xử lý</span>
                                            break;
                                        case DonationStatus.Failed:
                                            <span class="badge bg-danger text-white px-2 py-1 rounded-pill">Thất bại</span>
                                            break;
                                        case DonationStatus.Cancelled:
                                            <span class="badge bg-secondary text-white px-2 py-1 rounded-pill">Đã hủy</span>
                                            break;
                                        case DonationStatus.Disputed:
                                            <span class="badge bg-purple text-white px-2 py-1 rounded-pill" style="background-color: #9333ea;">Đang Khiếu nại</span>
                                            break;
                                        case DonationStatus.Refunded:
                                            <span class="badge bg-dark text-white px-2 py-1 rounded-pill">Đã hoàn tiền</span>
                                            break;
                                    }
                                </td>

                                <!-- Cột khiếu nại & audit log -->
                                <td>
                                    @if (tx.IsDisputed)
                                    {
                                        <div class="badge bg-danger text-white mb-1">
                                            <i class="fa-solid fa-triangle-exclamation me-1"></i> Khiếu nại
                                        </div>
                                        @if (!string.IsNullOrEmpty(tx.DisputeReason))
                                        {
                                            <div class="small text-danger fw-semibold text-truncate" style="max-width: 180px;" title="@tx.DisputeReason">
                                                @tx.DisputeReason
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">Bình thường</span>
                                    }

                                    <!-- Số log audit -->
                                    <div class="mt-1">
                                        <span class="small text-muted font-monospace" style="font-size: 0.72rem;">
                                            <i class="fa-solid fa-clock-rotate-left me-1"></i>@tx.AuditLogCount vết kiểm tra
                                        </span>
                                    </div>
                                </td>

                                <!-- Thời gian -->
                                <td class="small text-muted">
                                    @tx.CreatedAt.ToString("dd/MM/yyyy")<br>
                                    <span style="font-size: 0.75rem;">@tx.CreatedAt.ToString("HH:mm:ss")</span>
                                </td>

                                <!-- Thao tác -->
                                <td class="text-center">
                                    <a href="/Admin/TransactionDetail/@tx.Id" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm" title="Kiểm tra chi tiết và nhật ký xử lý">
                                        <i class="fa-solid fa-shield-halved me-1"></i> Kiểm tra log
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-receipt fs-1 text-muted mb-2 d-block"></i>
                                Không tìm thấy giao dịch nào thỏa mãn điều kiện tìm kiếm.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- PHÂN TRANG (PAGINATION) -->
@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Transactions", new { page = Model.CurrentPage - 1, search = Model.SearchCodeOrDonor, status = Model.StatusFilter, paymentMethod = Model.PaymentMethodFilter, isDisputed = Model.IsDisputedFilter })">
                    &laquo; Trước
                </a>
            </li>

            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Transactions", new { page = p, search = Model.SearchCodeOrDonor, status = Model.StatusFilter, paymentMethod = Model.PaymentMethodFilter, isDisputed = Model.IsDisputedFilter })">
                        @p
                    </a>
                </li>
            }

            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Transactions", new { page = Model.CurrentPage + 1, search = Model.SearchCodeOrDonor, status = Model.StatusFilter, paymentMethod = Model.PaymentMethodFilter, isDisputed = Model.IsDisputedFilter })">
                    Sau &raquo;
                </a>
            </li>
        </ul>
    </nav>
}
