@model DonateWeb.Areas.Admin.ViewModels.AdminStreamerListViewModel
@{
    ViewData["Title"] = "Quản lý Trạng Thái Streamer";
}

<!-- FILE: Areas/Admin/Views/Admin/Streamers.cshtml -->
<!-- CHỨC NĂNG: QUẢN LÝ TRẠNG THÁI STREAMER (KHÓA KÊNH VI PHẠM, KÍCH HOẠT KÊNH, CẤP TÍCH XANH) -->

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1 text-dark">
            <i class="fa-solid fa-headset text-info me-2"></i>Quản Lý Trạng Thái Streamer
        </h4>
        <p class="text-muted small mb-0">Kiểm soát hoạt động, khóa kênh vi phạm tiêu chuẩn cộng đồng, cấp tích xanh xác minh</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a href="/Admin/Streamers" class="badge bg-light text-dark border text-decoration-none px-3 py-2 fs-6">
            Tổng: <strong class="text-primary">@Model.TotalStreamers</strong>
        </a>
        <a href="/Admin/Streamers?statusFilter=pending" class="badge @(Model.PendingCount > 0 ? "bg-warning text-dark border border-warning" : "bg-light text-muted border") text-decoration-none px-3 py-2 fs-6">
            <i class="fa-solid fa-clock me-1"></i> Chờ duyệt: <strong>@Model.PendingCount</strong>
        </a>
        <a href="/Admin/Streamers?statusFilter=active" class="badge bg-success-subtle text-success border border-success-subtle text-decoration-none px-3 py-2 fs-6">
            Hoạt động: <strong>@Model.ActiveCount</strong>
        </a>
        <a href="/Admin/Streamers?statusFilter=locked" class="badge bg-danger-subtle text-danger border border-danger-subtle text-decoration-none px-3 py-2 fs-6">
            Bị khóa: <strong>@Model.LockedCount</strong>
        </a>
        @if (Model.RejectedCount > 0)
        {
            <a href="/Admin/Streamers?statusFilter=rejected" class="badge bg-secondary-subtle text-secondary border border-secondary-subtle text-decoration-none px-3 py-2 fs-6">
                Từ chối: <strong>@Model.RejectedCount</strong>
            </a>
        }
    </div>
</div>

<!-- KHUNG TÌM KIẾM VÀ BỘ LỌC -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <!-- Tìm kiếm -->
            <div class="col-12 col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" name="search" class="form-control border-start-0 ps-0" 
                           placeholder="Tìm kiếm theo tên kênh, slug, username, email..." 
                           value="@Model.SearchTerm" />
                </div>
            </div>

            <!-- Lọc trạng thái -->
            <div class="col-6 col-md-3">
                <select name="statusFilter" class="form-select">
                    <option value="all" selected="@(Model.StatusFilter == "all")">-- Tất cả trạng thái --</option>
                    <option value="pending" selected="@(Model.StatusFilter == "pending")">⏳ Chờ duyệt (@Model.PendingCount)</option>
                    <option value="active" selected="@(Model.StatusFilter == "active" || Model.StatusFilter == "approved")">✅ Đang hoạt động (Đã duyệt)</option>
                    <option value="locked" selected="@(Model.StatusFilter == "locked")">🔒 Đang bị khóa vi phạm</option>
                    <option value="rejected" selected="@(Model.StatusFilter == "rejected")">❌ Bị từ chối duyệt (@Model.RejectedCount)</option>
                </select>
            </div>

            <!-- Lọc xác minh -->
            <div class="col-6 col-md-2">
                <select name="verificationFilter" class="form-select">
                    <option value="all" selected="@(Model.VerificationFilter == "all")">-- Tích xanh --</option>
                    <option value="verified" selected="@(Model.VerificationFilter == "verified")">Đã xác minh</option>
                    <option value="unverified" selected="@(Model.VerificationFilter == "unverified")">Chưa xác minh</option>
                </select>
            </div>

            <!-- Nút bấm -->
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="fa-solid fa-filter me-1"></i> Lọc
                </button>
                <a href="/Admin/Streamers" class="btn btn-outline-secondary" title="Đặt lại bộ lọc">
                    <i class="fa-solid fa-rotate-right"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- BẢNG DANH SÁCH STREAMER -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="small text-muted text-uppercase">
                        <th>Mã ID (10 số)</th>
                        <th>Kênh Streamer</th>
                        <th>Tên Miền Trang Cá Nhân</th>
                        <th>Chủ Tài Khoản</th>
                        <th class="text-end">Mức Donate Min</th>
                        <th class="text-end">Tổng Tiền Nhận</th>
                        <th class="text-center">Trạng Thái</th>
                        <th class="text-center" style="min-width: 180px;">Thao Tác Quản Trị</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Streamers.Any())
                    {
                        foreach (var s in Model.Streamers)
                        {
                            var rowClass = "";
                            if (s.ApprovalStatus == DonateWeb.Models.Enums.StreamerApprovalStatus.Pending)
                            {
                                rowClass = "table-warning-subtle";
                            }
                            else if (!s.IsActive)
                            {
                                rowClass = "table-danger-subtle";
                            }
                            else if (s.ApprovalStatus == DonateWeb.Models.Enums.StreamerApprovalStatus.Rejected)
                            {
                                rowClass = "table-secondary-subtle";
                            }

                            <tr class="@rowClass">
                                <!-- Mã ID (10 số) -->
                                <td>
                                    @if (!string.IsNullOrEmpty(s.AccountId))
                                    {
                                        var isPendingStreamer = s.ApprovalStatus == DonateWeb.Models.Enums.StreamerApprovalStatus.Pending;
                                        var badgeColor = isPendingStreamer ? "text-warning border-warning" : "text-dark-green border-success";
                                        var iconColor = isPendingStreamer ? "text-warning" : "text-success";
                                        <span class="badge bg-white @badgeColor border font-monospace px-2 py-1" style="font-size: 0.82rem; letter-spacing: 0.05em;" title="@(isPendingStreamer ? "Mã ID Viewer hiện tại (sẽ đổi thành đầu 1 khi Admin duyệt)" : "Mã ID Streamer chính thức")">
                                            <i class="fa-solid fa-id-badge @iconColor me-1"></i>@s.AccountId
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa cấp</span>
                                    }
                                </td>

                                <!-- Kênh Streamer -->
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@s.AvatarUrl" class="rounded-circle border" width="42" height="42" alt="@s.DisplayName">
                                        <div>
                                            <div class="fw-bold text-dark">
                                                @s.DisplayName
                                                @if (s.IsVerified)
                                                {
                                                    <i class="fa-solid fa-circle-check text-primary small ms-1" title="Đã cấp tích xanh"></i>
                                                }
                                            </div>
                                            <span class="small text-muted">@s.FollowerCount.ToString("N0") người theo dõi</span>
                                        </div>
                                    </div>
                                </td>

                                <!-- Slug -->
                                <td>
                                    <a href="/@s.Slug" target="_blank" class="badge bg-light text-primary border text-decoration-none px-2 py-1">
                                        /@s.Slug <i class="fa-solid fa-arrow-up-right-from-square ms-1 small"></i>
                                    </a>
                                </td>

                                <!-- Chủ tài khoản -->
                                <td>
                                    <div class="small fw-semibold text-dark">@s.OwnerFullName</div>
                                    <div class="small text-muted font-monospace">@@@s.Username | @s.OwnerEmail</div>
                                </td>

                                <!-- Mức min -->
                                <td class="text-end small">
                                    @s.MinDonateAmount.ToString("N0") đ
                                </td>

                                <!-- Tổng tiền nhận -->
                                <td class="text-end fw-bold text-success">
                                    @s.TotalReceived.ToString("N0") đ
                                </td>

                                <!-- Trạng thái -->
                                <td class="text-center">
                                    @if (s.ApprovalStatus == DonateWeb.Models.Enums.StreamerApprovalStatus.Pending)
                                    {
                                        <div>
                                            <span class="badge bg-warning text-dark px-3 py-1 rounded-pill shadow-sm">
                                                <i class="fa-solid fa-clock me-1"></i> Chờ duyệt
                                            </span>
                                            <div class="small text-muted mt-1" style="font-size: 0.7rem;">
                                                Gửi lúc: @s.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                            </div>
                                        </div>
                                    }
                                    else if (s.ApprovalStatus == DonateWeb.Models.Enums.StreamerApprovalStatus.Rejected)
                                    {
                                        <div>
                                            <span class="badge bg-secondary text-white px-3 py-1 rounded-pill">
                                                <i class="fa-solid fa-ban me-1 small"></i> Bị từ chối
                                            </span>
                                            @if (!string.IsNullOrEmpty(s.RejectionReason))
                                            {
                                                <div class="small text-danger fw-semibold mt-1" style="font-size: 0.75rem;" title="@s.RejectionReason">
                                                    Lý do: @s.RejectionReason
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (s.IsActive)
                                    {
                                        <div>
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">
                                                <i class="fa-solid fa-circle-dot me-1 small"></i> Hoạt động
                                            </span>
                                            @if (s.ApprovedAt.HasValue)
                                            {
                                                <div class="small text-muted" style="font-size: 0.7rem;">
                                                    Duyệt: @s.ApprovedAt.Value.ToString("dd/MM/yyyy")
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div>
                                            <span class="badge bg-danger text-white px-3 py-1 rounded-pill">
                                                <i class="fa-solid fa-lock me-1 small"></i> Bị Khóa
                                            </span>
                                            @if (!string.IsNullOrEmpty(s.LockReason))
                                            {
                                                <div class="small text-danger fw-semibold mt-1" style="font-size: 0.75rem;" title="@s.LockReason">
                                                    Lý do: @s.LockReason
                                                </div>
                                            }
                                            @if (s.LockedAt.HasValue)
                                            {
                                                <div class="small text-muted" style="font-size: 0.7rem;">
                                                    Khóa lúc: @s.LockedAt.Value.ToString("dd/MM/yyyy HH:mm")
                                                </div>
                                            }
                                        </div>
                                    }
                                </td>

                                <!-- Thao tác -->
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1 flex-wrap">
                                        @if (s.ApprovalStatus == DonateWeb.Models.Enums.StreamerApprovalStatus.Pending)
                                        {
                                            <!-- NÚT DUYỆT STREAMER -->
                                            <form asp-area="Admin" asp-controller="Admin" asp-action="ApproveStreamer" method="post" class="d-inline"
                                                  onsubmit="return confirm('Xác nhận PHÊ DUYỆT cho streamer \'@s.DisplayName\'?\n\n- Kênh sẽ được kích hoạt hoạt động.\n- Tài khoản được cấp quyền Streamer.\n- Mã ID 10 số sẽ được nâng cấp (số đầu đổi từ 9 thành 1).');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@s.Id" />
                                                <button type="submit" class="btn btn-sm btn-success fw-semibold" title="Phê duyệt Streamer">
                                                    <i class="fa-solid fa-check me-1"></i> Duyệt
                                                </button>
                                            </form>

                                            <!-- NÚT TỪ CHỐI DUYỆT -->
                                            <button type="button" class="btn btn-sm btn-outline-danger" 
                                                    data-bs-toggle="modal" 
                                                    data-bs-target="#rejectStreamerModal" 
                                                    data-streamer-id="@s.Id" 
                                                    data-streamer-name="@s.DisplayName"
                                                    data-streamer-slug="@s.Slug"
                                                    title="Từ chối đơn đăng ký Streamer">
                                                <i class="fa-solid fa-xmark me-1"></i> Từ chối
                                            </button>
                                        }
                                        else if (s.ApprovalStatus == DonateWeb.Models.Enums.StreamerApprovalStatus.Rejected)
                                        {
                                            <!-- NÚT DUYỆT LẠI -->
                                            <form asp-area="Admin" asp-controller="Admin" asp-action="ApproveStreamer" method="post" class="d-inline"
                                                  onsubmit="return confirm('Xác nhận DUYỆT LẠI cho streamer \'@s.DisplayName\'?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@s.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Duyệt lại hồ sơ">
                                                    <i class="fa-solid fa-check me-1"></i> Duyệt lại
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <!-- NÚT KHÓA KÊNH / KÍCH HOẠT KÊNH (Dành cho kênh đã duyệt) -->
                                            @if (s.IsActive)
                                            {
                                                <!-- Mở Modal Khóa kênh -->
                                                <button type="button" class="btn btn-sm btn-outline-danger" 
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#lockModal" 
                                                        data-streamer-id="@s.Id" 
                                                        data-streamer-name="@s.DisplayName"
                                                        data-streamer-slug="@s.Slug"
                                                        title="Khóa kênh vi phạm chính sách">
                                                    <i class="fa-solid fa-ban me-1"></i> Khóa
                                                </button>
                                            }
                                            else
                                            {
                                                <!-- Form Kích hoạt mở khóa -->
                                                <form asp-area="Admin" asp-controller="Admin" asp-action="UnlockStreamer" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn kích hoạt lại kênh @s.DisplayName?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@s.Id" />
                                                    <button type="submit" class="btn btn-sm btn-success" title="Kích hoạt lại kênh hoạt động">
                                                        <i class="fa-solid fa-unlock me-1"></i> Kích hoạt
                                                    </button>
                                                </form>
                                            }

                                            <!-- NÚT CẤP / THU HỒI TÍCH XANH -->
                                            <form asp-area="Admin" asp-controller="Admin" asp-action="ToggleVerify" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@s.Id" />
                                                <button type="submit" class="btn btn-sm @(s.IsVerified ? "btn-outline-primary" : "btn-light border")" 
                                                        title="@(s.IsVerified ? "Thu hồi tích xanh" : "Cấp tích xanh xác minh")">
                                                    <i class="fa-solid fa-circle-check @(s.IsVerified ? "text-primary" : "text-muted")"></i>
                                                </button>
                                            </form>
                                        }

                                        <!-- Nút xem trang donate -->
                                        <a href="/@s.Slug" target="_blank" class="btn btn-sm btn-light border" title="Xem trang donate thực tế">
                                            <i class="fa-solid fa-eye text-secondary"></i>
                                        </a>

                                        <!-- NÚT XÓA STREAMER -->
                                        <button type="button" class="btn btn-sm btn-outline-danger" 
                                                data-bs-toggle="modal" 
                                                data-bs-target="#deleteStreamerModal" 
                                                data-streamer-id="@s.Id" 
                                                data-streamer-name="@s.DisplayName"
                                                data-streamer-slug="@s.Slug"
                                                title="Xóa kênh Streamer">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-folder-open fs-1 text-muted mb-2 d-block"></i>
                                Không tìm thấy streamer nào phù hợp với bộ lọc.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL KHÓA KÊNH STREAMER VI PHẠM -->
<div class="modal fade" id="lockModal" tabindex="-1" aria-labelledby="lockModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-area="Admin" asp-controller="Admin" asp-action="LockStreamer" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="modalStreamerId" value="" />

                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="lockModalLabel">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>Khóa Kênh Streamer Vi Phạm
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="alert alert-warning small border-0 d-flex gap-2">
                        <i class="fa-solid fa-circle-info fs-5"></i>
                        <div>
                            Khi bị khóa, trang donate của streamer sẽ hiển thị thông báo vi phạm và <strong>vô hiệu hóa hoàn toàn nút donate</strong> để ngăn chặn chuyển tiền.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Kênh bị khóa:</label>
                        <div class="form-control-plaintext fw-bold text-danger fs-6" id="modalStreamerInfo">--</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Lý do khóa kênh <span class="text-danger">*</span>:</label>
                        <textarea name="reason" id="modalLockReason" class="form-control" rows="3" 
                                  placeholder="Nhập chi tiết hành vi vi phạm chính sách của streamer..." required></textarea>
                    </div>

                    <!-- Gợi ý lý do vi phạm nhanh -->
                    <div class="mb-2">
                        <span class="small text-muted d-block mb-1">Gợi ý lý do phổ biến:</span>
                        <div class="d-flex flex-wrap gap-1">
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0" onclick="setReason('Nội dung phản cảm, kích động thù địch')">Nội dung phản cảm</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0" onclick="setReason('Gian lận giao dịch donate / Nghi vấn rửa tiền')">Gian lận donate</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0" onclick="setReason('Vi phạm bản quyền video hoặc âm thanh')">Bản quyền</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0" onclick="setReason('Tài khoản bị khiếu nại nhiều lần chưa giải quyết')">Khiếu nại kéo dài</button>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fa-solid fa-lock me-1"></i> Xác nhận Khóa Kênh
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL XÓA STREAMER -->
<div class="modal fade" id="deleteStreamerModal" tabindex="-1" aria-labelledby="deleteStreamerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-area="Admin" asp-controller="Admin" asp-action="DeleteStreamer" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="modalDeleteStreamerId" value="" />

                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="deleteStreamerModalLabel">
                        <i class="fa-solid fa-trash-can me-2"></i>Xác nhận Xóa Streamer
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="alert alert-danger-subtle border-0 d-flex gap-2 mb-3">
                        <i class="fa-solid fa-triangle-exclamation text-danger fs-5 flex-shrink-0 mt-1"></i>
                        <div>
                            <strong>Cảnh báo hành động quan trọng!</strong><br />
                            Bạn đang thực hiện xóa kênh Streamer: <strong id="modalDeleteStreamerInfo" class="text-danger"></strong>.
                        </div>
                    </div>

                    <p class="small text-muted mb-3">
                        Hồ sơ kênh streamer, cấu hình widget và mục tiêu donate liên quan sẽ bị xóa vĩnh viễn khỏi hệ thống.
                    </p>

                    <div class="form-check p-3 rounded-3 border bg-light">
                        <input class="form-check-input" type="checkbox" name="deleteUserAccount" value="true" id="checkDeleteUserAccount" />
                        <label class="form-check-label small fw-semibold text-dark" for="checkDeleteUserAccount">
                            Xóa vĩnh viễn cả tài khoản người dùng khỏi hệ thống
                        </label>
                        <div class="text-muted" style="font-size: 0.72rem;">
                            (Mặc định: Bỏ chọn sẽ giữ lại tài khoản người dùng và chuyển về vai trò <strong>Viewer</strong> với mã ID bắt đầu bằng <strong>9</strong>).
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-danger fw-semibold">
                        <i class="fa-solid fa-trash-can me-1"></i> Xác nhận Xóa
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL TỪ CHỐI DUYỆT STREAMER -->
<div class="modal fade" id="rejectStreamerModal" tabindex="-1" aria-labelledby="rejectStreamerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-area="Admin" asp-controller="Admin" asp-action="RejectStreamer" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="modalRejectStreamerId" value="" />

                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold" id="rejectStreamerModalLabel">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>Từ Chối Duyệt Đơn Đăng Ký Streamer
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="alert alert-warning-subtle border-0 d-flex gap-2 mb-3">
                        <i class="fa-solid fa-circle-info fs-5 flex-shrink-0 mt-1"></i>
                        <div>
                            Người dùng sẽ nhận được lý do từ chối và có thể cập nhật lại hồ sơ để gửi xét duyệt lại.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Kênh xét duyệt:</label>
                        <div class="form-control-plaintext fw-bold text-dark fs-6" id="modalRejectStreamerInfo">--</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark">Lý do từ chối <span class="text-danger">*</span>:</label>
                        <textarea name="reason" id="modalRejectReason" class="form-control" rows="3" 
                                  placeholder="Nhập lý do hồ sơ chưa đạt tiêu chuẩn phê duyệt..." required></textarea>
                    </div>

                    <!-- Gợi ý lý do từ chối -->
                    <div class="mb-2">
                        <span class="small text-muted d-block mb-1">Gợi ý lý do phổ biến:</span>
                        <div class="d-flex flex-wrap gap-1">
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0" onclick="setRejectReason('Thông tin Căn cước công dân (CCCD) chưa rõ ràng hoặc không khớp')">CCCD không khớp</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0" onclick="setRejectReason('Tên chủ tài khoản ngân hàng không khớp với họ tên đăng ký')">Tên ngân hàng lệch</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0" onclick="setRejectReason('Tên hiển thị hoặc slug định danh không phù hợp với quy chuẩn cộng đồng')">Slug/Tên chưa chuẩn</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0" onclick="setRejectReason('Chưa đủ 18 tuổi hoặc thiếu giấy tờ giám hộ theo quy định')">Độ tuổi chưa đủ</button>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-danger fw-semibold">
                        <i class="fa-solid fa-xmark me-1"></i> Xác nhận Từ Chối
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Truyền dữ liệu vào Modal khi click nút Khóa kênh
        const lockModal = document.getElementById('lockModal');
        if (lockModal) {
            lockModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const streamerId = button.getAttribute('data-streamer-id');
                const streamerName = button.getAttribute('data-streamer-name');
                const streamerSlug = button.getAttribute('data-streamer-slug');

                document.getElementById('modalStreamerId').value = streamerId;
                document.getElementById('modalStreamerInfo').textContent = streamerName + ' (/' + streamerSlug + ')';
                document.getElementById('modalLockReason').value = '';
            });
        }

        // Truyền dữ liệu vào Modal khi click nút Xóa streamer
        const deleteModal = document.getElementById('deleteStreamerModal');
        if (deleteModal) {
            deleteModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const streamerId = button.getAttribute('data-streamer-id');
                const streamerName = button.getAttribute('data-streamer-name');
                const streamerSlug = button.getAttribute('data-streamer-slug');

                document.getElementById('modalDeleteStreamerId').value = streamerId;
                document.getElementById('modalDeleteStreamerInfo').textContent = streamerName + ' (/' + streamerSlug + ')';
                document.getElementById('checkDeleteUserAccount').checked = false;
            });
        }

        // Truyền dữ liệu vào Modal khi click nút Từ chối duyệt
        const rejectModal = document.getElementById('rejectStreamerModal');
        if (rejectModal) {
            rejectModal.addEventListener('show.bs.modal', function (event) {
                const button = event.relatedTarget;
                const streamerId = button.getAttribute('data-streamer-id');
                const streamerName = button.getAttribute('data-streamer-name');
                const streamerSlug = button.getAttribute('data-streamer-slug');

                document.getElementById('modalRejectStreamerId').value = streamerId;
                document.getElementById('modalRejectStreamerInfo').textContent = streamerName + ' (/' + streamerSlug + ')';
                document.getElementById('modalRejectReason').value = '';
            });
        }

        function setReason(text) {
            document.getElementById('modalLockReason').value = text;
        }

        function setRejectReason(text) {
            document.getElementById('modalRejectReason').value = text;
        }
    </script>
}
