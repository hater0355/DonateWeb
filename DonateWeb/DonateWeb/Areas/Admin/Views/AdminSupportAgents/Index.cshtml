@model DonateWeb.Areas.Admin.ViewModels.SupportAgentManagementViewModel
@{
    ViewData["Title"] = "Quản lý Hỗ trợ viên";
}

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-4">
        <div>
            <h1 class="h3 mb-1">Hỗ trợ viên</h1>
            <p class="text-muted mb-0">Chọn tối đa hai tài khoản Viewer để trực hộp thư hỗ trợ.</p>
        </div>
        <a class="btn btn-outline-secondary" href="/Admin"><i class="fa-solid fa-arrow-left me-1"></i>Về Admin</a>
    </div>

    @if (TempData["SupportAgentsSuccess"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    @if (TempData["SupportAgentsError"] is string error)
    {
        <div class="alert alert-danger">@error</div>
    }

    <section class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>Đang được cấp quyền</strong><span class="badge text-bg-primary">@Model.Agents.Count / @Model.MaximumAgents</span>
        </div>
        <div class="card-body">
            @if (Model.Agents.Count == 0)
            {
                <p class="text-muted mb-0">Chưa có Hỗ trợ viên.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>Họ tên</th><th>Tên đăng nhập</th><th>Email</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var agent in Model.Agents)
                        {
                            <tr>
                                <td>@agent.FullName</td><td>@agent.Username</td><td>@agent.Email</td>
                                <td class="text-end">
                                    <form method="post" action="/Admin/SupportAgents/Revoke">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@agent.Id" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Thu hồi quyền Hỗ trợ viên của tài khoản này?')">Thu hồi</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    @if (Model.Agents.Count < Model.MaximumAgents)
    {
        <section class="card shadow-sm">
            <div class="card-header"><strong>Cấp quyền cho tài khoản Viewer</strong></div>
            <div class="card-body">
                <form method="get" action="/Admin/SupportAgents" class="row g-2 mb-3">
                    <div class="col"><input class="form-control" name="search" value="@Model.Search" placeholder="Tìm theo tên, tài khoản hoặc email" /></div>
                    <div class="col-auto"><button class="btn btn-outline-primary" type="submit"><i class="fa-solid fa-magnifying-glass me-1"></i>Tìm</button></div>
                </form>
                @if (Model.Candidates.Count == 0)
                {
                    <p class="text-muted mb-0">Không tìm thấy tài khoản Viewer đang hoạt động. Tài khoản Admin và Streamer không được chọn làm Hỗ trợ viên.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th>Họ tên</th><th>Tên đăng nhập</th><th>Email</th><th></th></tr></thead>
                            <tbody>
                            @foreach (var candidate in Model.Candidates)
                            {
                                <tr>
                                    <td>@candidate.FullName</td><td>@candidate.Username</td><td>@candidate.Email</td>
                                    <td class="text-end">
                                        <form method="post" action="/Admin/SupportAgents/Grant">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@candidate.Id" />
                                            <button class="btn btn-sm btn-success" type="submit">Cấp quyền</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </section>
    }
</div>
