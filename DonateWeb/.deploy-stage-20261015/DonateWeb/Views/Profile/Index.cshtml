@model DonateWeb.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="fw-bold text-dark-green mb-0 d-flex align-items-center gap-2">
            <span class="border-start border-3 border-success ps-2">THÔNG TIN CÁ NHÂN</span>
        </h5>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success rounded-3 d-flex align-items-center gap-2 mb-4">
        <i class="fa-solid fa-circle-check fs-5"></i>
        <div>@TempData["SuccessMessage"]</div>
    </div>
}

<div class="row g-4">
    <!-- Panel trái: Thông tin cơ bản (Giữ nguyên cho Viewer & Admin) -->
    <div class="col-12 col-lg-6">
        <div class="card card-custom p-4 bg-light-green h-100 border-0 shadow-sm">
            <h6 class="fw-bold text-dark-green mb-4">THÔNG TIN CƠ BẢN</h6>

            <form asp-action="Index" asp-controller="Profile" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <!-- Mã ID Tài khoản (10 số) -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label small fw-semibold text-dark-green mb-0">Mã ID Tài khoản (10 số)</label>
                        <span class="badge @(Model.AccountId?.StartsWith("1") == true ? "bg-success" : "bg-primary") rounded-pill" style="font-size: 0.7rem;">
                            <i class="fa-solid @(Model.AccountId?.StartsWith("1") == true ? "fa-video" : "fa-user") me-1"></i>
                            @(Model.AccountId?.StartsWith("1") == true ? "ID Streamer" : "ID Viewer")
                        </span>
                    </div>
                    <div class="position-relative">
                        <input type="text" asp-for="AccountId" class="form-control form-control-custom fw-bold font-monospace text-dark-green pe-5" readonly style="letter-spacing: 0.08em; background-color: #f8fafc;" />
                        <span class="position-absolute top-50 end-0 translate-middle-y pe-3 text-muted">
                            <i class="fa-solid fa-id-card text-success"></i>
                        </span>
                    </div>
                    <small class="text-muted d-block mt-1" style="font-size: 0.73rem;">
                        @(Model.AccountId?.StartsWith("1") == true 
                            ? "ID Streamer bắt đầu bằng 1 kèm năm tạo và 5 số ngẫu nhiên." 
                            : "ID Viewer bắt đầu bằng 9. Khi đăng ký làm Streamer, số đầu sẽ tự động đổi từ 9 sang 1.")
                    </small>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-dark-green">Email</label>
                    <div class="position-relative">
                        <input type="email" asp-for="Email" class="form-control form-control-custom pe-5" readonly />
                        <span class="position-absolute top-50 end-0 translate-middle-y pe-3 text-muted">
                            <i class="fa-solid fa-envelope fa-sm"></i>
                        </span>
                    </div>
                </div>

                <!-- Tên đầy đủ -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-dark-green">Họ và tên</label>
                    <input type="text" asp-for="FullName" class="form-control form-control-custom" placeholder="Nhập họ và tên đầy đủ" />
                </div>

                <!-- Tên hiển thị -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-dark-green">Tên hiển thị</label>
                    <input type="text" asp-for="DisplayName" class="form-control form-control-custom" />
                </div>

                <!-- Hình đại diện (Upload File từ máy tính) -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-dark-green">Ảnh đại diện (Tải lên từ máy tính)</label>
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <img id="profileAvatarPreview"
                             src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "/images/default-avatar.png" : Model.AvatarUrl)" 
                             class="rounded-circle border object-fit-cover flex-shrink-0" width="60" height="60" alt="Avatar"
                             onerror="this.src='/images/default-avatar.png'" />
                        <div class="w-100">
                            <input type="file" name="avatarFile" asp-for="AvatarFile" accept="image/*" class="form-control form-control-custom"
                                   onchange="if(this.files && this.files[0]) document.getElementById('profileAvatarPreview').src = window.URL.createObjectURL(this.files[0]);" />
                            <input type="hidden" asp-for="AvatarUrl" />
                            <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">Hỗ trợ định dạng JPG, PNG, GIF, WEBP. Tải lên từ máy tính.</small>
                        </div>
                    </div>
                </div>

                <!-- Vai trò / Lĩnh vực -->
                <div class="mb-3">
                    <label class="form-label small fw-semibold text-dark-green">Vai trò tài khoản</label>
                    <input type="text" asp-for="Category" class="form-control form-control-custom" readonly />
                </div>

                <!-- Số điện thoại -->
                <div class="mb-4">
                    <label class="form-label small fw-semibold text-dark-green">Số điện thoại</label>
                    <input type="tel" asp-for="PhoneNumber" class="form-control form-control-custom" placeholder="Nhập số điện thoại" />
                </div>

                <!-- Nút Lưu -->
                <button type="submit" class="btn btn-dark-green px-4 py-2 fw-semibold rounded-pill">
                    <i class="fa-solid fa-floppy-disk me-1"></i> LƯU THAY ĐỔI
                </button>
            </form>
        </div>
    </div>

    <!-- Panel phải: Thông tin thanh toán (Giữ nguyên cho Viewer & Admin) -->
    <div class="col-12 col-lg-6">
        <div class="card card-custom p-4 bg-white h-100 border-0 shadow-sm">
            <h6 class="fw-bold text-dark-green mb-1">Thông tin thanh toán</h6>
            <small class="text-muted mb-4 d-block">Đăng ký nhận Donate qua QR</small>

            <div class="border rounded-3 d-flex align-items-center justify-content-center flex-column gap-2 mb-4"
                 style="min-height: 280px; border-style: dashed !important; border-color: var(--border-color);">
                <div class="text-center">
                    <div class="mb-2" style="font-size: 2.5rem; color: var(--dark-green); opacity: 0.5;">
                        <i class="fa-solid fa-qrcode"></i>
                    </div>
                    <p class="mb-0 small text-muted">
                        Bạn đang là Viewer/Donor.
                        <br />
                        Muốn nhận Donate từ người hâm mộ?
                    </p>
                </div>
            </div>

            <a asp-controller="Streamer" asp-action="Register" class="btn btn-dark-green w-100 py-3 fw-bold rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2 fs-6">
                <i class="fa-solid fa-microphone-lines"></i> ĐĂNG KÝ TRỞ THÀNH STREAMER
            </a>
        </div>
    </div>
</div>
