@{
    ViewData["Title"] = "Không tìm thấy Streamer";
    var slug = ViewBag.NotFoundSlug as string ?? "";
}

<div class="text-center py-5">
    <div class="mb-4">
        <i class="fa-solid fa-user-astronaut text-success display-1"></i>
    </div>
    <h3 class="fw-bold text-dark-green mb-2">Không tìm thấy Streamer</h3>
    <p class="text-muted mb-4">
        Trang cá nhân của streamer với mã ID / tên miền <span class="badge bg-light-green text-dark-green fs-6 px-3 py-1 border">@slug</span> không tồn tại hoặc chưa được kích hoạt.
    </p>
    <div class="d-flex justify-content-center gap-3">
        <a href="/" class="btn btn-dark-green px-4 py-2 rounded-pill">
            <i class="fa-solid fa-home me-2"></i> Về trang chủ
        </a>
        <a href="/Streamer/Donate" class="btn btn-outline-success px-4 py-2 rounded-pill">
            <i class="fa-solid fa-list me-2"></i> Khám phá Streamer khác
        </a>
    </div>
</div>
