@using DonateWeb.Models.Entities
@using DonateWeb.Models.Enums
@{
    ViewData["Title"] = "Streamer Yêu Thích - Kênh Bạn Đã Theo Dõi";
    var currentStreamer = ViewBag.Streamer as StreamerProfile;
    var followedStreamers = ViewBag.FollowedStreamers as List<StreamerProfile> ?? new List<StreamerProfile>();
    var isStreamer = currentStreamer != null;
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Người dùng";
}

<!-- FILE: Views/Streamer/Overview.cshtml -->
<!-- PHẦN ICON TRÁI TIM: CHỈ HIỂN THỊ NHỮNG STREAMER ĐÃ ẤN THEO DÕI -->

<style>
    .fav-streamer-card {
        border-radius: 16px;
        background: #ffffff;
        border: 1px solid rgba(163, 199, 181, 0.45);
        transition: all 0.25s ease;
        overflow: hidden;
    }
    .fav-streamer-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 20px rgba(27, 69, 51, 0.1);
        border-color: #2d6a4f;
    }
    .fav-unfollow-btn {
        transition: all 0.2s ease;
        border-radius: 50%;
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
    }
    .fav-unfollow-btn:hover {
        background-color: #dc3545 !important;
        color: #ffffff !important;
        border-color: #dc3545 !important;
    }
</style>

<!-- Thông báo TempData -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success rounded-3 d-flex align-items-center gap-2 p-3 mb-4 shadow-sm">
        <i class="fa-solid fa-circle-check fs-5 text-success"></i>
        <div class="fw-semibold">@TempData["SuccessMessage"]</div>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger rounded-3 d-flex align-items-center gap-2 p-3 mb-4 shadow-sm">
        <i class="fa-solid fa-triangle-exclamation fs-5 text-danger"></i>
        <div class="fw-semibold">@TempData["ErrorMessage"]</div>
    </div>
}

<!-- BANNER ĐẦU TRANG: STREAMER YÊU THÍCH -->
<div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden" style="background: linear-gradient(135deg, #1b4533 0%, #29503e 100%); color: white;">
    <div class="card-body p-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle p-3 bg-white text-danger d-flex align-items-center justify-content-center shadow-sm flex-shrink-0" style="width: 56px; height: 56px;">
                <i class="fa-solid fa-heart fs-3 text-danger"></i>
            </div>
            <div>
                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                    <span class="badge bg-danger text-white rounded-pill px-3 py-1 fw-bold" style="letter-spacing: 0.05em;">
                        <i class="fa-solid fa-heart me-1"></i> STREAMER YÊU THÍCH
                    </span>
                    <span id="followedCountBadge" class="badge bg-white text-dark-green rounded-pill px-2.5 py-1 small fw-bold">
                        Đang theo dõi: @followedStreamers.Count kênh
                    </span>
                </div>
                <h4 class="fw-bold mb-1 text-white">Danh Sách Streamer Bạn Đã Theo Dõi</h4>
                <p class="mb-0 text-white-50 small">
                    Mục trái tim chỉ hiển thị các Streamer bạn đã nhấn "Theo dõi". Vào trang cá nhân, mua sắm hoặc gửi donate cho Idol của bạn.
                </p>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/Streamer/Donate" class="btn btn-warning rounded-pill px-4 py-2 fw-bold text-dark shadow-sm">
                <i class="fa-solid fa-compass me-1"></i> Khám phá thêm Streamer
            </a>
            <a href="/Shop" class="btn btn-outline-light rounded-pill px-3 py-2 fw-semibold small">
                <i class="fa-solid fa-cart-shopping me-1"></i> Sàn Shop
            </a>
        </div>
    </div>
</div>

<!-- NẾU NGƯỜI DÙNG LÀ STREAMER: HIỂN THỊ THANH TIỆN ÍCH KÊNH CỦA BẠN GỌN GÀNG -->
@if (isStreamer)
{
    <div class="alert alert-light border border-success-subtle rounded-4 p-3 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2 shadow-xs bg-white">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle overflow-hidden border border-success bg-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px;">
                @if (!string.IsNullOrEmpty(currentStreamer!.AvatarUrl) && currentStreamer.AvatarUrl != "/images/default-avatar.png")
                {
                    <img src="@currentStreamer.AvatarUrl" alt="@currentStreamer.DisplayName" class="w-100 h-100 object-fit-cover" onerror="this.src='/images/default-avatar.png'" />
                }
                else
                {
                    <i class="fa-solid fa-user text-success"></i>
                }
            </div>
            <div>
                <div class="fw-bold text-dark-green small d-flex align-items-center gap-2 flex-wrap">
                    <span>Kênh của bạn: <strong>@currentStreamer.DisplayName</strong></span>
                    <span class="badge bg-success font-monospace" style="font-size: 0.7rem;">ID: @(currentStreamer.User?.AccountId ?? currentStreamer.Slug)</span>
                    <span class="badge bg-light text-dark-green border rounded-pill" style="font-size: 0.7rem;">Rank #@currentStreamer.Rank</span>
                </div>
                <div class="text-muted small" style="font-size: 0.78rem;">
                    <i class="fa-solid fa-users text-success me-1"></i>@currentStreamer.FollowerCount.ToString("N0") người theo dõi &bull; 
                    <i class="fa-solid fa-money-bill-wave text-warning me-1"></i>Đã nhận: @currentStreamer.TotalReceived.ToString("N0") đ
                </div>
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/@currentStreamer.Slug" class="btn btn-sm btn-outline-success rounded-pill px-3 fw-semibold">
                <i class="fa-solid fa-id-card me-1"></i> Trang cá nhân
            </a>
            <a href="/Streamer/Config" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                <i class="fa-solid fa-sliders me-1"></i> Cấu hình nhận donate
            </a>
            <a href="/Shop/MyProducts" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                <i class="fa-solid fa-boxes-stacked me-1"></i> Gian hàng Shop
            </a>
            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2.5" data-bs-toggle="modal" data-bs-target="#overviewCancelStreamerModal" title="Hủy tư cách Streamer">
                <i class="fa-solid fa-user-xmark"></i>
            </button>
        </div>
    </div>
}

<!-- TIÊU ĐỀ KHỐI STREAMER YÊU THÍCH -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold text-dark-green mb-0 d-flex align-items-center gap-2">
        <i class="fa-solid fa-heart text-danger"></i>
        STREAMER ĐÃ THEO DÕI
    </h5>
    <span id="followedCountText" class="text-muted small">(@followedStreamers.Count Streamer)</span>
</div>

<!-- DANH SÁCH STREAMER ĐÃ THEO DÕI -->
<div class="row g-3 mb-4" id="followedStreamersGrid">
    @if (followedStreamers.Any())
    {
        @foreach (var kol in followedStreamers)
        {
            <div class="col-12 col-md-6 col-xl-4" id="fav-card-@kol.Id">
                <div class="fav-streamer-card p-3 shadow-sm h-100 d-flex flex-column justify-content-between position-relative">
                    <div>
                        <!-- Header Streamer -->
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <a href="/@kol.Slug" class="text-decoration-none d-flex align-items-center gap-3 overflow-hidden">
                                <div class="rounded-circle overflow-hidden border border-2 border-success bg-white d-flex align-items-center justify-content-center flex-shrink-0 shadow-xs" style="width: 50px; height: 50px;">
                                    @if (!string.IsNullOrEmpty(kol.AvatarUrl) && kol.AvatarUrl != "/images/default-avatar.png")
                                    {
                                        <img src="@kol.AvatarUrl" alt="@kol.DisplayName" class="w-100 h-100 object-fit-cover" onerror="this.src='/images/default-avatar.png'" />
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-user fs-4 text-success"></i>
                                    }
                                </div>
                                <div class="overflow-hidden">
                                    <div class="d-flex align-items-center gap-1">
                                        <h6 class="fw-bold text-dark-green mb-0 text-truncate">@kol.DisplayName</h6>
                                        @if (kol.IsVerified)
                                        {
                                            <i class="fa-solid fa-circle-check text-success fs-7" title="Đã xác minh"></i>
                                        }
                                    </div>
                                    <small class="text-muted d-block text-truncate font-monospace" style="font-size: 0.75rem;">
                                        domain.com/@kol.Slug
                                    </small>
                                </div>
                            </a>
                            <!-- Nút Bỏ theo dõi (Heart) -->
                            <button type="button" 
                                    class="btn btn-sm btn-outline-danger fav-unfollow-btn shadow-xs" 
                                    onclick="unfollowStreamer(@kol.Id, 'fav-card-@kol.Id')" 
                                    title="Bỏ theo dõi @kol.DisplayName">
                                <i class="fa-solid fa-heart text-danger"></i>
                            </button>
                        </div>

                        <!-- Thông tin phụ: Rank, Follower, Lời chào -->
                        <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small fw-semibold">
                                <i class="fa-solid fa-leaf me-1"></i> Rank #@kol.Rank
                            </span>
                            <span class="badge bg-light text-dark-green border rounded-pill px-2 py-1 small">
                                <i class="fa-solid fa-fire text-danger me-1"></i> @kol.FollowerCount.ToString("N0") theo dõi
                            </span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(kol.GreetingMessage))
                        {
                            <p class="text-muted small fst-italic mb-3 text-truncate-2" style="font-size: 0.8rem; min-height: 38px;">
                                "@kol.GreetingMessage"
                            </p>
                        }
                        else
                        {
                            <p class="text-muted small fst-italic mb-3 text-truncate" style="font-size: 0.8rem; min-height: 38px;">
                                "Cảm ơn bạn đã luôn đồng hành và ủng hộ mình nhé!"
                            </p>
                        }
                    </div>

                    <!-- Hành động: Vào trang cá nhân & Donate -->
                    <div class="d-flex align-items-center gap-2 pt-2 border-top">
                        <a href="/@kol.Slug" class="btn btn-sm btn-light text-dark-green fw-bold border rounded-pill px-3 flex-grow-1 text-center">
                            <i class="fa-solid fa-id-badge me-1"></i> Trang cá nhân
                        </a>
                        <a href="/@kol.Slug" class="btn btn-sm btn-success rounded-pill px-3 fw-bold flex-grow-1 text-center shadow-xs">
                            <i class="fa-solid fa-heart me-1"></i> Donate
                        </a>
                        <a href="/Shop/StreamerShop?slug=@kol.Slug" class="btn btn-sm btn-outline-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Vào Shop của @kol.DisplayName">
                            <i class="fa-solid fa-store text-dark"></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- KHUNG EMPTY STATE: KHI CHƯA THEO DÕI STREAMER NÀO -->
<div id="emptyFollowedContainer" class="card card-custom p-5 bg-white text-center rounded-4 shadow-sm border-0 mb-4 @(followedStreamers.Any() ? "d-none" : "")">
    <div class="py-4">
        <div class="rounded-circle bg-danger-subtle text-danger d-inline-flex align-items-center justify-content-center p-4 mb-3" style="width: 80px; height: 80px;">
            <i class="fa-regular fa-heart fa-2x text-danger"></i>
        </div>
        <h5 class="fw-bold text-dark-green mb-2">Bạn chưa theo dõi Streamer nào</h5>
        <p class="text-muted small mb-4 mx-auto" style="max-width: 520px;">
            Phần icon trái tim này là <strong>Streamer Yêu Thích</strong>, chỉ hiển thị những Streamer mà bạn đã nhấn <strong>"Theo dõi"</strong>. Hãy ghé thăm trang cá nhân của các Streamer bạn yêu thích và nhấn nút <strong>Theo dõi (❤️)</strong> để họ xuất hiện tại đây!
        </p>
        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <a href="/Streamer/Donate" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm">
                <i class="fa-solid fa-compass me-1"></i> Khám phá danh sách Streamer
            </a>
            <a href="/Shop" class="btn btn-outline-success rounded-pill px-4 py-2 fw-semibold">
                <i class="fa-solid fa-cart-shopping me-1"></i> Sàn sản phẩm Shop
            </a>
        </div>
    </div>
</div>

<!-- STORY CỦA CÁC STREAMER ĐÃ THEO DÕI -->
@if (followedStreamers.Any())
{
    <div id="storySectionContainer">
        <h5 class="fw-bold text-dark-green mb-3 d-flex align-items-center gap-2">
            <i class="fa-solid fa-film text-success"></i>
            STORY CỦA STREAMER BẠN THEO DÕI
        </h5>
        <div class="story-container d-flex gap-3 overflow-auto pb-2 mb-4">
            @foreach (var st in followedStreamers)
            {
                <a href="/@st.Slug" class="text-decoration-none">
                    <div class="card card-custom bg-light-green p-3 flex-shrink-0" style="width: 175px; height: 185px; transition: 0.2s;">
                        <div class="d-flex align-items-center gap-2 mb-3">
                            <div class="rounded-circle bg-white text-secondary overflow-hidden d-flex align-items-center justify-content-center flex-shrink-0 border" style="width:36px; height:36px;">
                                @if (!string.IsNullOrEmpty(st.AvatarUrl) && st.AvatarUrl != "/images/default-avatar.png")
                                {
                                    <img src="@st.AvatarUrl" alt="@st.DisplayName" class="w-100 h-100 object-fit-cover" onerror="this.src='/images/default-avatar.png'" />
                                }
                                else
                                {
                                    <i class="fa-solid fa-user"></i>
                                }
                            </div>
                            <div class="lh-sm overflow-hidden">
                                <div class="fw-bold text-dark-green text-truncate" style="font-size:0.85rem;">@st.DisplayName</div>
                                <small class="text-muted" style="font-size:0.75rem;"><i class="fa-solid fa-fire text-danger"></i> @st.FollowerCount.ToString("N0")</small>
                            </div>
                        </div>
                        <div class="mt-auto small text-success fw-semibold">
                            <i class="fa-solid fa-leaf me-1"></i> Rank #@st.Rank
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>
}

@if (isStreamer)
{
    <!-- Modal xác nhận Hủy Streamer -->
    <div class="modal fade" id="overviewCancelStreamerModal" tabindex="-1" aria-labelledby="overviewCancelStreamerModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <form asp-action="CancelStreamer" asp-controller="Streamer" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title" id="overviewCancelStreamerModalLabel">
                            <i class="fa-solid fa-triangle-exclamation me-2"></i>Xác nhận Hủy Kênh Streamer
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="alert alert-warning small border-0 d-flex gap-2 mb-3">
                            <i class="fa-solid fa-circle-exclamation text-warning fs-5 flex-shrink-0 mt-1"></i>
                            <div>
                                <strong>Lưu ý quan trọng:</strong><br />
                                Kênh Streamer <code>/@currentStreamer?.Slug</code> của bạn sẽ bị hủy. Các tiện ích OBS, cấu hình nhận donate và mục tiêu sẽ bị xóa.
                            </div>
                        </div>
                        <p class="small text-muted mb-2">
                            Tài khoản của bạn sẽ không bị mất và được chuyển về vai trò <strong>Viewer</strong>.
                        </p>
                        <p class="small text-dark fw-semibold mb-0">
                            <i class="fa-solid fa-id-badge text-success me-1"></i> Mã ID của bạn sẽ tự động chuyển đổi chữ số đầu tiên từ <strong>1</strong> sang <strong>9</strong>.
                        </p>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-danger fw-semibold">
                            <i class="fa-solid fa-user-xmark me-1"></i> Xác nhận Hủy Kênh
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<script>
    // Xử lý Bỏ theo dõi Streamer trực tiếp trên trang Streamer Yêu Thích
    function unfollowStreamer(streamerProfileId, cardElementId) {
        if (!confirm('Bạn có chắc muốn bỏ theo dõi Streamer này khỏi danh sách Yêu thích?')) {
            return;
        }

        fetch('/Streamer/ToggleFollow', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ streamerProfileId: streamerProfileId })
        })
        .then(function(res) {
            if (!res.ok) throw new Error('Network error');
            return res.json();
        })
        .then(function(data) {
            if (data.success) {
                var card = document.getElementById(cardElementId);
                if (card) {
                    card.style.transition = 'all 0.35s ease';
                    card.style.opacity = '0';
                    card.style.transform = 'scale(0.85)';
                    setTimeout(function() {
                        card.remove();
                        checkEmptyFavorites();
                    }, 350);
                }
            } else {
                alert(data.message || 'Không thể thực hiện thao tác.');
            }
        })
        .catch(function(err) {
            console.error(err);
            alert('Có lỗi kết nối, vui lòng thử lại.');
        });
    }

    function checkEmptyFavorites() {
        var grid = document.getElementById('followedStreamersGrid');
        var remainingCards = grid ? grid.querySelectorAll('.fav-streamer-card') : [];
        var count = remainingCards.length;

        var countBadge = document.getElementById('followedCountBadge');
        if (countBadge) countBadge.textContent = 'Đang theo dõi: ' + count + ' kênh';

        var countText = document.getElementById('followedCountText');
        if (countText) countText.textContent = '(' + count + ' Streamer)';

        if (count === 0) {
            var emptyContainer = document.getElementById('emptyFollowedContainer');
            if (emptyContainer) {
                emptyContainer.classList.remove('d-none');
            }
            var storySection = document.getElementById('storySectionContainer');
            if (storySection) {
                storySection.classList.add('d-none');
            }
        }
    }
</script>