# Copy to .env and replace placeholders. Never commit .env or real credentials.
DB_SERVER=host.docker.internal
DB_PORT=1433
DB_NAME=DonateWebDB
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
PAYOS_CLIENT_ID=replace-with-payOS-client-id
PAYOS_API_KEY=replace-with-payOS-api-key
PAYOS_CHECKSUM_KEY=replace-with-payOS-checksum-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# GHN integration uses staging preview only; it does not create shipping orders.
GHN_TOKEN=
GHN_SHOP_ID=230944
SEPAY_API_KEY=
# OpenAI API key for the support assistant. Never put this key in browser JavaScript.
SUPPORT_AI_API_KEY=
SUPPORT_AI_MODEL=gpt-5.4-mini
SUPPORT_AI_MONTHLY_TOKEN_LIMIT=100000
SUPPORT_AI_MAX_OUTPUT_TOKENS=500
# Điền URL HTTPS công khai sau khi có domain (ví dụ https://donate.example.com).
PUBLIC_BASE_URL=
PLATFORM_CONTRACT_OPERATOR_CAPACITY=Cá nhân
PLATFORM_CONTRACT_OPERATOR_LEGAL_NAME=Nguyễn Anh Hiếu
PLATFORM_CONTRACT_OPERATOR_ADDRESS=Thông tin minh họa (bài tập lớn)
PLATFORM_CONTRACT_OPERATOR_REGISTRATION_NUMBER=Không áp dụng trong bản demo cá nhân
PLATFORM_CONTRACT_CONTACT_EMAIL=cupitcookies@gmail.com
