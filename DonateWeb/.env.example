# Copy to .env and replace placeholders. Never commit .env or real credentials.
DB_SERVER=host.docker.internal
DB_PORT=1433
DB_NAME=DonateWebDB
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
PAYOS_CLIENT_ID=replace-with-payOS-client-id
PAYOS_API_KEY=replace-with-payOS-api-key
PAYOS_CHECKSUM_KEY=replace-with-payOS-checksum-key
