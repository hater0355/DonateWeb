@model List<DonateWeb.Models.Entities.DiscountCoupon>
@{
    ViewData["Title"] = "Quản lý mã giảm giá";
    var nowUtc = DateTime.UtcNow;
}

<div class="mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <h5 class="fw-bold text-dark-green mb-1">QUẢN LÝ MÃ GIẢM GIÁ</h5>
        <div class="small text-muted">Admin tạo mã tại đây; khách nhập mã khi thanh toán sản phẩm ở Shop.</div>
    </div>
    <button class="btn btn-dark-green fw-semibold px-3 py-2" data-bs-toggle="modal" data-bs-target="#addCouponModal">
        <i class="fa-solid fa-plus me-1"></i> TẠO MÃ MỚI
    </button>
</div>

@if (TempData["CouponSuccess"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}
@if (TempData["CouponError"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

<div class="card card-custom p-3 mb-3 bg-light-green">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-7">
            <label for="searchCoupon" class="form-label small fw-semibold text-dark-green">TÌM MÃ</label>
            <input type="search" id="searchCoupon" class="form-control form-control-custom" placeholder="Nhập mã, nội dung hoặc nhà cung cấp" />
        </div>
        <div class="col-12 col-md-3">
            <label for="couponStatus" class="form-label small fw-semibold text-dark-green">TRẠNG THÁI</label>
            <select id="couponStatus" class="form-select form-control-custom">
                <option value="">Tất cả</option>
                <option value="active">Đang hoạt động</option>
                <option value="paused">Đã tắt</option>
                <option value="expired">Hết hạn</option>
            </select>
        </div>
        <div class="col-12 col-md-2">
            <button type="button" class="btn btn-outline-secondary w-100" onclick="clearCouponFilters()">Xóa lọc</button>
        </div>
    </div>
</div>

<div class="card card-custom bg-white">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr style="background-color: var(--light-green);">
                    <th class="py-3 px-3 text-dark-green small">Mã giảm giá</th>
                    <th class="py-3 px-3 text-dark-green small">Nhà cung cấp</th>
                    <th class="py-3 px-3 text-dark-green small">Nội dung</th>
                    <th class="py-3 px-3 text-dark-green small">Mức giảm</th>
                    <th class="py-3 px-3 text-dark-green small">Ngày tạo / hết hạn</th>
                    <th class="py-3 px-3 text-dark-green small">Đã dùng</th>
                    <th class="py-3 px-3 text-dark-green small">Trạng thái</th>
                    <th class="py-3 px-3 text-dark-green small">Thao tác</th>
                </tr>
            </thead>
            <tbody id="couponsBody">
                @foreach (var coupon in Model)
                {
                    var expired = coupon.ExpiresAtUtc.HasValue && coupon.ExpiresAtUtc.Value <= nowUtc;
                    var status = expired ? "expired" : coupon.IsActive ? "active" : "paused";
                    var statusLabel = expired ? "Hết hạn" : coupon.IsActive ? "Đang hoạt động" : "Đã tắt";
                    var badgeClass = expired ? "bg-danger" : coupon.IsActive ? "bg-success" : "bg-secondary";
                    var discountLabel = coupon.DiscountType == "Percent"
                        ? $"{coupon.DiscountValue:0.##}%"
                        : $"{coupon.DiscountValue:N0} VNĐ";
                    var expiresLocal = coupon.ExpiresAtUtc?.AddHours(7).ToString("dd/MM/yyyy");
                    <tr class="coupon-row"
                        data-status="@status"
                        data-search="@($"{coupon.Code} {coupon.Content} {coupon.Provider}".ToLowerInvariant())">
                        <td class="px-3 fw-bold text-dark-green font-monospace">@coupon.Code</td>
                        <td class="px-3">@coupon.Provider</td>
                        <td class="px-3">@coupon.Content</td>
                        <td class="px-3 fw-semibold">@discountLabel</td>
                        <td class="px-3 small text-muted">
                            <div>@coupon.CreatedAtUtc.AddHours(7).ToString("dd/MM/yyyy")</div>
                            <div>Hết hạn: @(expiresLocal ?? "Không")</div>
                        </td>
                        <td class="px-3 text-center">@coupon.UsedCount</td>
                        <td class="px-3"><span class="badge rounded-pill @badgeClass">@statusLabel</span></td>
                        <td class="px-3">
                            @if (!expired)
                            {
                                <form action="/Coupons/Toggle" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@coupon.Id" />
                                    <button type="submit" class="btn btn-sm @(coupon.IsActive ? "btn-outline-danger" : "btn-outline-success")"
                                            title="@(coupon.IsActive ? "Tắt mã" : "Bật lại mã")">
                                        <i class="fa-solid @(coupon.IsActive ? "fa-ban" : "fa-rotate-left")"></i>
                                        @(coupon.IsActive ? "Tắt" : "Bật")
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                <tr id="emptyCouponRow" class="@(Model.Count == 0 ? "" : "d-none")">
                    <td colspan="8" class="text-center py-5 text-muted small">
                        @(Model.Count == 0 ? "Chưa có mã giảm giá nào. Tạo mã đầu tiên để khách dùng tại Shop." : "Không có mã phù hợp với bộ lọc.")
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="px-3 py-2 border-top small text-muted">Tổng số mã: @Model.Count</div>
</div>

<div class="modal fade" id="addCouponModal" tabindex="-1" aria-labelledby="addCouponModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form action="/Coupons/Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold text-dark-green" id="addCouponModalLabel">Tạo mã giảm giá</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="newCode" class="form-label small fw-semibold">Mã giảm giá</label>
                        <input type="text" id="newCode" name="code" class="form-control" maxlength="50" placeholder="Ví dụ: CHAOHE2026" required />
                        <div class="form-text">Mã tự đổi thành chữ in hoa; chỉ dùng chữ không dấu, số, dấu - hoặc _.</div>
                    </div>
                    <div class="mb-3">
                        <label for="newContent" class="form-label small fw-semibold">Nội dung / điều kiện hiển thị</label>
                        <input type="text" id="newContent" name="content" class="form-control" maxlength="250" placeholder="Ví dụ: Ưu đãi chào hè" required />
                    </div>
                    <div class="mb-3">
                        <label for="newProvider" class="form-label small fw-semibold">Nhà cung cấp</label>
                        <input type="text" id="newProvider" name="provider" class="form-control" maxlength="100" placeholder="Ví dụ: DonateWeb" required />
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label for="newDiscountType" class="form-label small fw-semibold">Kiểu giảm</label>
                            <select id="newDiscountType" name="discountType" class="form-select" onchange="updateDiscountInput()">
                                <option value="Percent">Phần trăm (%)</option>
                                <option value="Fixed">Số tiền (VNĐ)</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label for="newDiscountValue" class="form-label small fw-semibold">Mức giảm</label>
                            <input type="number" id="newDiscountValue" name="discountValue" class="form-control" min="0.01" max="99" step="0.01" placeholder="10" required />
                        </div>
                    </div>
                    <div class="mt-3">
                        <label for="newExpire" class="form-label small fw-semibold">Ngày hết hạn (không bắt buộc)</label>
                        <input type="date" id="newExpire" name="expiresOn" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-dark-green fw-semibold">Tạo mã</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const searchInput = document.getElementById("searchCoupon");
    const statusInput = document.getElementById("couponStatus");
    const emptyRow = document.getElementById("emptyCouponRow");

    function filterCoupons() {
        const query = (searchInput.value || "").trim().toLowerCase();
        const status = statusInput.value;
        let visible = 0;
        document.querySelectorAll(".coupon-row").forEach(row => {
            const matches = (!query || row.dataset.search.includes(query))
                && (!status || row.dataset.status === status);
            row.classList.toggle("d-none", !matches);
            if (matches) visible++;
        });
        emptyRow.classList.toggle("d-none", visible !== 0);
        if (visible === 0 && @Model.Count > 0) {
            emptyRow.querySelector("td").textContent = "Không có mã phù hợp với bộ lọc.";
        }
    }

    function clearCouponFilters() {
        searchInput.value = "";
        statusInput.value = "";
        filterCoupons();
    }

    function updateDiscountInput() {
        const isPercent = document.getElementById("newDiscountType").value === "Percent";
        const input = document.getElementById("newDiscountValue");
        input.max = isPercent ? "99" : "1000000000";
        input.min = isPercent ? "0.01" : "1";
        input.step = isPercent ? "0.01" : "1";
        input.placeholder = isPercent ? "10" : "50000";
    }

    searchInput.addEventListener("input", filterCoupons);
    statusInput.addEventListener("change", filterCoupons);
    document.getElementById("newCode").addEventListener("input", event => {
        event.target.value = event.target.value.toUpperCase();
    });
</script>
}
